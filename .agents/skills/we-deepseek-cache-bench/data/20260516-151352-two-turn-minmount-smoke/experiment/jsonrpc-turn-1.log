 ----\n  function refreshMetrics() {\n    if (!$metrics) return;\n    const m = DATA.getMetrics();\n    $metrics.innerHTML = Components.renderMetricsRow(m);\n  }\n\n  function refreshAccountList() {\n    if (!$accountList) return;\n    let filtered;\n    let errorMsg = null;\n\n    try {\n      filtered = Utils.filterAccounts(DATA.riskProfiles, DATA.accounts, state.filters);\n    } catch (e) {\n      errorMsg = e.message;\n      filtered = [];\n    }\n\n    // Error banner\n    if ($errorContainer) {\n      if (state.error) {\n        $errorContainer.innerHTML = Components.renderErrorState(state.error);\n      } else if (errorMsg) {\n        $errorContainer.innerHTML = Components.renderErrorState(errorMsg);\n      } else {\n        $errorContainer.innerHTML = '';\n      }\n    }\n\n    if (!$accountList) return;\n\n    if (filtered.length === 0) {\n      $accountList.innerHTML = Components.renderEmptyState();\n      if ($summary) $summary.textContent = '0 results';\n      return;\n    }\n\n    if ($summary) $summary.textContent = filtered.length + ' of ' + DATA.accounts.length + ' accounts';\n\n    $accountList.innerHTML = filtered.map(p => {\n      const acct = DATA.getAccountById(p.accountId);\n      if (!acct) return '';\n      return Components.renderAccountRow(acct, p, state.expandedId === acct.id);\n    }).join('');\n\n    // Attach expand listeners\n    $accountList.querySelectorAll('.account-summary').forEach(el => {\n      el.addEventListener('click', (e) => {\n        const row = el.closest('.account-row');\n        if (!row) return;\n        const id = row.dataset.accountId;\n        toggleDetail(id);\n        e.stopPropagation();\n      });\n    });\n\n    // Attach close-detail buttons\n    $accountList.querySelectorAll('[data-action=\"close-detail\"]').forEach(btn => {\n      btn.addEventListener('click', (e) => {\n        const id = btn.dataset.id;\n        closeDetail(id);\n        e.stopPropagation();\n      });\n    });\n\n    // Render already-expanded detail\n    if (state.expandedId) {\n      renderDetailPanel(state.expandedId);\n    }\n  }\n\n  function toggleDetail(id) {\n    if (state.expandedId === id) {\n      closeDetail(id);\n    } else {\n      // Close previous\n      if (state.expandedId) closeDetail(state.expandedId);\n      state.expandedId = id;\n      renderDetailPanel(id);\n      const row = document.querySelector(`.account-row[data-account-id=\"${id}\"]`);\n      if (row) row.classList.add('expanded');\n    }\n  }\n\n  function closeDetail(id) {\n    const row = document.querySelector(`.account-row[data-account-id=\"${id}\"]`);\n    if (row) {\n      row.classList.remove('expanded');\n      const panel = row.querySelector('.account-detail');\n      if (panel) {\n        panel.classList.remove('visible');\n        panel.innerHTML = '';\n      }\n    }\n    state.expandedId = null;\n  }\n\n  function renderDetailPanel(id) {\n    const row = document.querySelector(`.account-row[data-account-id=\"${id}\"]`);\n    if (!row) return;\n    const panel = row.querySelector('.account-detail');\n    if (!panel) return;\n    const acct = DATA.getAccountById(id);\n    const profile = DATA.getRiskProfile(id);\n    if (!acct || !profile) return;\n    panel.innerHTML = Components.renderAccountDetail(acct, profile);\n    panel.classList.add('visible');\n  }\n\n  // ---- Event handlers ----\n  function onSearchInput() {\n    state.filters.search = $search ? $search.value : '';\n    refreshAccountList();\n  }\n\n  function onRiskFilterChange() {\n    state.filters.riskFilter = $riskFilter ? $riskFilter.value : 'all';\n    refreshAccountList();\n  }\n\n  function onDomainFilterChange() {\n    state.filters.domainFilter = $domainFilter ? $domainFilter.value : 'all';\n    refreshAccountList();\n  }\n\n  function onFilterChipClick(chip) {\n    const domain = chip.dataset.domain;\n    if (!domain) return;\n    // Toggle: if already active, clear; else set\n    if (state.filters.domainFilter === domain) {\n      state.filters.domainFilter = 'all';\n      $filterChips.forEach(c => c.classList.remove('active'));\n      if ($domainFilter) $domainFilter.value = 'all';\n    } else {\n      state.filters.domainFilter = domain;\n      $filterChips.forEach(c => c.classList.toggle('active', c.dataset.domain === domain));\n      if ($domainFilter) $domainFilter.value = domain;\n    }\n    refreshAccountList();\n  }\n\n  // ---- Init ----\n  async function init() {\n    try {\n      await Utils.simulateLoad(200);\n\n      if (!DATA.accounts || DATA.accounts.length === 0) {\n        throw new Error('Account data is empty — check data.js');\n      }\n\n      refreshMetrics();\n      refreshAccountList();\n      state.ready = true;\n\n    } catch (e) {\n      state.error = e.message;\n      if ($errorContainer) {\n        $errorContainer.innerHTML = Components.renderErrorState(e.message);\n      }\n    }\n  }\n\n  // Bind events\n  if ($search) $search.addEventListener('input', onSearchInput);\n  if ($riskFilter) $riskFilter.addEventListener('change', onRiskFilterChange);\n  if ($domainFilter) $domainFilter.addEventListener('change', onDomainFilterChange);\n  $filterChips.forEach(chip => {\n    chip.addEventListener('click', () => onFilterChipClick(chip));\n  });\n\n  // Keyboard: Escape closes detail\n  document.addEventListener('keydown', (e) => {\n    if (e.key === 'Escape' && state.expandedId) {\n      closeDetail(state.expandedId);\n      refreshAccountList();\n    }\n  });\n\n  // Start\n  if (document.readyState === 'loading') {\n    document.addEventListener('DOMContentLoaded', init);\n  } else {\n    init();\n  }\n})();\nENDOFFILE"}],"aggregatedOutput":null,"exitCode":null,"durationMs":null},"threadId":"019e2fa3-65fc-7381-a85d-304bffcc8f7b","turnId":"019e2fa3-6611-75b3-a4b4-77c5da9b8a36","startedAtMs":1778916242936}}
