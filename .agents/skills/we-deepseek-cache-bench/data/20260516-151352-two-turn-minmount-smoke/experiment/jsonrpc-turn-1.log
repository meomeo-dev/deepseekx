  text-transform: uppercase;\n  letter-spacing: 0.05em;\n}\n.risk-badge.critical { background: var(--critical-bg); color: var(--critical); }\n.risk-badge.high { background: var(--red-bg); color: var(--red); }\n.risk-badge.medium { background: var(--amber-bg); color: var(--amber); }\n.risk-badge.low { background: var(--green-bg); color: var(--green); }\n\n.domain-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));\n  gap: 10px;\n}\n.domain-card {\n  background: var(--bg-card);\n  border: 1px solid var(--border);\n  border-radius: var(--radius);\n  padding: 14px;\n}\n.domain-card h4 {\n  font-size: 11px;\n  font-weight: 600;\n  text-transform: uppercase;\n  letter-spacing: 0.06em;\n  color: var(--text-muted);\n  margin-bottom: 8px;\n}\n.domain-card .domain-item {\n  font-size: 12px;\n  color: var(--text-secondary);\n  padding: 3px 0;\n  display: flex;\n  justify-content: space-between;\n  gap: 8px;\n}\n.domain-card .domain-item .status-tag {\n  font-size: 10px;\n  font-weight: 600;\n  padding: 1px 6px;\n  border-radius: 4px;\n  white-space: nowrap;\n}\n.status-tag.at-risk, .status-tag.critical { background: var(--red-bg); color: var(--red); }\n.status-tag.overdue { background: var(--red-bg); color: var(--red); }\n.status-tag.open, .status-tag.investigating { background: var(--amber-bg); color: var(--amber); }\n.status-tag.in-progress, .status-tag.pending { background: var(--amber-bg); color: var(--amber); }\n.status-tag.healthy, .status-tag.paid, .status-tag.resolved { background: var(--green-bg); color: var(--green); }\n.domain-card .empty-domain {\n  font-size: 12px;\n  color: var(--text-muted);\n  font-style: italic;\n}\n\n/* ---- Action buttons ---- */\n.btn {\n  font-size: 12px;\n  font-weight: 600;\n  padding: 6px 14px;\n  border-radius: var(--radius);\n  border: 1px solid var(--border);\n  background: var(--bg-input);\n  color: var(--text-secondary);\n  cursor: pointer;\n  font-family: var(--font);\n  transition: all var(--transition);\n}\n.btn:hover { border-color: var(--border-active); color: var(--text-primary); }\n.btn.primary { background: var(--accent); color: #fff; border-color: var(--accent); }\n.btn.primary:hover { filter: brightness(1.1); }\n\n/* ---- Empty & Error States ---- */\n.empty-state {\n  padding: 60px 20px;\n  text-align: center;\n  color: var(--text-muted);\n}\n.empty-state .empty-icon { font-size: 48px; margin-bottom: 12px; opacity: 0.4; }\n.empty-state p { font-size: 14px; }\n.empty-state .empty-hint { font-size: 12px; margin-top: 4px; color: var(--text-muted); }\n\n.error-banner {\n  background: var(--red-bg);\n  border: 1px solid var(--red);\n  border-radius: var(--radius);\n  padding: 14px 18px;\n  margin-bottom: 20px;\n  color: var(--red);\n  font-size: 13px;\n  font-weight: 500;\n}\n.error-banner .error-title { font-weight: 700; margin-bottom: 2px; }\n\n/* ---- Responsive ---- */\n@media (max-width: 768px) {\n  .app-main { padding: 12px; }\n  .account-summary {\n    grid-template-columns: 1fr 1fr;\n    gap: 6px;\n    font-size: 12px;\n  }\n  .toolbar { flex-direction: column; }\n  .toolbar .summary-text { margin-left: 0; }\n  .domain-grid { grid-template-columns: 1fr; }\n}\nENDOFFILE"}],"aggregatedOutput":null,"exitCode":0,"durationMs":0},"threadId":"019e2fa3-65fc-7381-a85d-304bffcc8f7b","turnId":"019e2fa3-6611-75b3-a4b4-77c5da9b8a36","completedAtMs":1778916083408}}
