  padding: 24px;\n}\n\n/* ---- Metrics Row ---- */\n.metrics-row {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));\n  gap: 12px;\n  margin-bottom: 24px;\n}\n.metric-card {\n  background: var(--bg-card);\n  border: 1px solid var(--border);\n  border-radius: var(--radius-lg);\n  padding: 16px 18px;\n  transition: border-color var(--transition);\n}\n.metric-card:hover { border-color: var(--border-active); }\n.metric-card .metric-label {\n  font-size: 12px;\n  font-weight: 500;\n  color: var(--text-secondary);\n  text-transform: uppercase;\n  letter-spacing: 0.05em;\n  margin-bottom: 4px;\n}\n.metric-card .metric-value {\n  font-size: 24px;\n  font-weight: 700;\n  font-variant-numeric: tabular-nums;\n  letter-spacing: -0.02em;\n}\n.metric-card .metric-sub {\n  font-size: 12px;\n  color: var(--text-muted);\n  margin-top: 2px;\n}\n.metric-card.warn { border-color: var(--amber); background: var(--amber-bg); }\n.metric-card.danger { border-color: var(--red); background: var(--red-bg); }\n.metric-card .metric-value.warn { color: var(--amber); }\n.metric-card .metric-value.danger { color: var(--red); }\n\n/* ---- Toolbar ---- */\n.toolbar {\n  display: flex;\n  gap: 12px;\n  margin-bottom: 20px;\n  flex-wrap: wrap;\n  align-items: center;\n}\n.toolbar input[type=\\\"search\\\"] {\n  flex: 1;\n  min-width: 220px;\n  max-width: 420px;\n  background: var(--bg-input);\n  border: 1px solid var(--border);\n  border-radius: var(--radius);\n  padding: 8px 14px;\n  font-size: 14px;\n  color: var(--text-primary);\n  font-family: var(--font);\n  outline: none;\n  transition: border-color var(--transition);\n}\n.toolbar input[type=\\\"search\\\"]:focus { border-color: var(--accent); }\n.toolbar input[type=\\\"search\\\"]::placeholder { color: var(--text-muted); }\n.toolbar select {\n  background: var(--bg-input);\n  border: 1px solid var(--border);\n  border-radius: var(--radius);\n  padding: 8px 12px;\n  font-size: 13px;\n  color: var(--text-primary);\n  font-family: var(--font);\n  outline: none;\n  cursor: pointer;\n}\n.toolbar select:focus { border-color: var(--accent); }\n.toolbar .filter-group {\n  display: flex;\n  gap: 6px;\n}\n.toolbar .filter-chip {\n  font-size: 12px;\n  font-weight: 500;\n  background: var(--bg-input);\n  border: 1px solid var(--border);\n  border-radius: 20px;\n  padding: 5px 14px;\n  cursor: pointer;\n  color: var(--text-secondary);\n  transition: all var(--transition);\n  user-select: none;\n}\n.toolbar .filter-chip:hover { border-color: var(--border-active); color: var(--text-primary); }\n.toolbar .filter-chip.active { background: var(--accent-glow); border-color: var(--accent); color: var(--accent); }\n.toolbar .summary-text {\n  margin-left: auto;\n  font-size: 12px;\n  color: var(--text-muted);\n}\n\n/* ---- Account List ---- */\n.account-list { display: flex; flex-direction: column; gap: 4px; }\n.account-row {\n  background: var(--bg-card);\n  border: 1px solid var(--border);\n  border-radius: var(--radius-lg);\n  overflow: hidden;\n  transition: border-color var(--transition), background var(--transition);\n}\n.account-row:hover { background: var(--bg-card-hover); }\n.account-row.expanded { border-color: var(--border-active); }\n\n.account-summary {\n  display: grid;\n  grid-template-columns: 1.2fr 0.6fr 0.7fr 0.5fr 1fr;\n  align-items: center;\n  padding: 14px 18px;\n  cursor: pointer;\n  gap: 12px;\n  font-size: 13px;\n}\n.account-summary .acct-name { font-weight: 600; color: var(--text-primary); }\n.account-summary .acct-tier { font-size: 11px; color: var(--text-secondary); }\n.account-summary .acct-arr { font-variant-numeric: tabular-nums; text-align: right; }\n.account-summary .acct-score { text-align: center; }\n.account-summary .risk-pills { display: flex; gap: 5px; flex-wrap: wrap; }\n.risk-pill {\n  font-size: 10px;\n  font-weight: 600;\n  padding: 2px 8px;\n  border-radius: 10px;\n  text-transform: uppercase;\n  letter-spacing: 0.03em;\n}\n.risk-pill.renewals { backgr