< {"method":"item/started","params":{"item":{"type":"commandExecution","id":"call_00_3PtOE5llPRYcMteuIu2X5887","command":"/bin/bash -lc \"cd /bench/20260516-151352-two-turn-minmount-smoke/workspace && sed -i '147i\\\\\n\\\\\n  // ---- Playbooks: risk-pattern response guides ----\\\\\n  const playbooks = [\\\\\n    { id: \\\"pb-001\\\", domain: \\\"renewals\\\", riskPattern: \\\"renewal_critical\\\", title: \\\"Executive Save Play\\\",\\\\\n      steps: [\\\"Schedule exec-to-exec call within 48h\\\", \\\"Prepare retention offer with 10-15% discount\\\", \\\"Escalate to VP Customer Success\\\", \\\"Draft mutual success plan\\\"],\\\\\n      impactLabel: \\\"Revenue at risk\\\" },\\\\\n    { id: \\\"pb-002\\\", domain: \\\"renewals\\\", riskPattern: \\\"renewal_at_risk\\\", title: \\\"Engagement Recovery\\\",\\\\\n      steps: [\\\"Reach out to champion within 5 business days\\\", \\\"Schedule product health review\\\", \\\"Identify adoption gaps and propose training\\\", \\\"Offer quarterly business review\\\"],\\\\\n      impactLabel: \\\"Revenue at risk\\\" },\\\\\n    { id: \\\"pb-003\\\", domain: \\\"billing\\\", riskPattern: \\\"invoice_overdue\\\", title: \\\"Payment Recovery\\\",\\\\\n      steps: [\\\"Send payment reminder with invoice copy\\\", \\\"Call finance contact within 3 days\\\", \\\"Offer payment plan if >30d overdue\\\", \\\"Flag for collections review at 60d\\\"],\\\\\n      impactLabel: \\\"Outstanding amount\\\" },\\\\\n    { id: \\\"pb-004\\\", domain: \\\"support\\\", riskPattern: \\\"support_p1\\\", title: \\\"P1 Escalation Protocol\\\",\\\\\n      steps: [\\\"Acknowledge within SLA window\\\", \\\"Assign dedicated engineer\\\", \\\"Post hourly status updates to customer\\\", \\\"Root cause analysis within 48h of resolution\\\"],\\\\\n      impactLabel: \\\"SLA status\\\" },\\\\\n    { id: \\\"pb-005\\\", domain: \\\"usage\\\", riskPattern: \\\"usage_decline\\\", title: \\\"Adoption Rescue\\\",\\\\\n      steps: [\\\"Analyze feature usage drop-off points\\\", \\\"Schedule training session for key users\\\", \\\"Identify champion and re-engage\\\", \\\"Set 30-day usage recovery target\\\"],\\\\\n      impactLabel: \\\"Active users\\\" },\\\\\n    { id: \\\"pb-006\\\", domain: \\\"incidents\\\", riskPattern: \\\"incident_active\\\", title: \\\"Incident Response\\\",\\\\\n      steps: [\\\"Confirm incident severity and scope\\\", \\\"Post public status update within 30 min\\\", \\\"Engage on-call engineering lead\\\", \\\"Provide post-mortem within 5 business days\\\"],\\\\\n      impactLabel: \\\"Services affected\\\" },\\\\\n  ];\\\\\n\\\\\n  // ---- Actions Queue: derived concrete tasks ----\\\\\n  function buildActions() {\\\\\n    const actions = [];\\\\\n    let seq = 1;\\\\\n\\\\\n    // Renewal actions\\\\\n    renewals.forEach(r => {\\\\\n      if (r.status === \\\"Critical\\\" || r.status === \\\"At Risk\\\") {\\\\\n        const acct = accounts.find(a => a.id === r.accountId);\\\\\n        actions.push({\\\\\n          id: \\\"act-\\\" + String(seq++).padStart(3, \\\"0\\\"),\\\\\n          accountId: r.accountId,\\\\\n          accountName: acct ? acct.name : \\\"\\\",\\\\\n          domain: \\\"renewals\\\",\\\\\n          title: \\\"Save renewal for \\\" + (acct ? acct.name : r.accountId),\\\\\n          description: \\\"Contract ends \\\" + r.contractEnd + \\\". Status: \\\" + r.status + \\\". \\\" + r.riskFlags.join(\\\"; \\\") + \\\".\\\",\\\\\n          owner: acct ? acct.csm : \\\"Unassigned\\\",\\\\\n          dueDate: r.contractEnd,\\\\\n          impact: r.amount,\\\\\n          status: \\\"pending\\\",\\\\\n          sourceId: r.id,\\\\\n          playbookId: r.status === \\\"Critical\\\" ? \\\"pb-001\\\" : \\\"pb-002\\\",\\\\\n        });\\\\\n      }\\\\\n    });\\\\\n\\\\\n    // Billing actions\\\\\n    invoices.forEach(inv => {\\\\\n      if (inv.status === \\\"Overdue\\\") {\\\\\n        const acct = accounts.find(a => a.id === inv.accountId);\\\\\n        actions.push({\\\\\n   