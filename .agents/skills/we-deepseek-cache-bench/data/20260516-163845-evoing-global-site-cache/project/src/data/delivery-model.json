{
  "title": {
    "zh": "全球交付模式",
    "en": "Global Delivery Model"
  },
  "subtitle": {
    "zh": "从战略咨询到工程交付，我们的全球团队如何协同工作",
    "en": "How our global teams collaborate from strategy advisory to engineering delivery"
  },
  "engagementModels": [
    {
      "id": "strategic-advisory",
      "label": {
        "zh": "战略咨询模式",
        "en": "Strategic Advisory"
      },
      "desc": {
        "zh": "由合伙人带领的小型专家团队，专注于战略、诊断和路线图设计。典型团队 3-6 人，周期 6-12 周。",
        "en": "Small expert team led by a Partner, focused on strategy, diagnosis, and roadmap design. Typical team 3-6, duration 6-12 weeks."
      },
      "teamComposition": {
        "zh": [
          "合伙人 (1)",
          "高级顾问 (1-2)",
          "行业专家 (1-2)",
          "项目经理 (1)"
        ],
        "en": [
          "Partner (1)",
          "Senior Consultant (1-2)",
          "Industry Expert (1-2)",
          "Project Manager (1)"
        ]
      },
      "cadence": {
        "zh": "周度客户同步、双周度指导委员会、月度交付成果评审",
        "en": "Weekly client sync, bi-weekly steering committee, monthly deliverable review"
      }
    },
    {
      "id": "embedded-squad",
      "label": {
        "zh": "嵌入式 Squad",
        "en": "Embedded Squad"
      },
      "desc": {
        "zh": "Evoing 工程师嵌入客户团队，与客户工程师并肩工作。典型 squad 4-8 人，周期 12-24 周。",
        "en": "Evoing engineers embedded in client teams, working alongside client engineers. Typical squad 4-8, duration 12-24 weeks."
      },
      "teamComposition": {
        "zh": [
          "技术负责人 (1)",
          "高级工程师 (2-4)",
          "平台/DevOps 工程师 (1-2)",
          "QA 工程师 (1)"
        ],
        "en": [
          "Tech Lead (1)",
          "Senior Engineers (2-4)",
          "Platform/DevOps Engineer (1-2)",
          "QA Engineer (1)"
        ]
      },
      "cadence": {
        "zh": "每日站会、双周 Sprint 评审、月度技术深度评审",
        "en": "Daily standup, bi-weekly Sprint review, monthly technical deep-dive"
      }
    },
    {
      "id": "dedicated-pod",
      "label": {
        "zh": "专属 Pod",
        "en": "Dedicated Pod"
      },
      "desc": {
        "zh": "Evoing 独立交付团队，通过明确的接口与客户团队协作。典型 pod 8-15 人，周期 6-18 个月。",
        "en": "Independent Evoing delivery team collaborating with client through defined interfaces. Typical pod 8-15, duration 6-18 months."
      },
      "teamComposition": {
        "zh": [
          "交付总监 (1)",
          "技术架构师 (1-2)",
          "工程师 (4-8)",
          "QA 工程师 (2-3)",
          "项目经理 (1)"
        ],
        "en": [
          "Delivery Director (1)",
          "Technical Architect (1-2)",
          "Engineers (4-8)",
          "QA Engineers (2-3)",
          "Project Manager (1)"
        ]
      },
      "cadence": {
        "zh": "每日内部站会、周度客户同步、双周度交付评审、月度指导委员会",
        "en": "Daily internal standup, weekly client sync, bi-weekly delivery review, monthly steering committee"
      }
    },
    {
      "id": "global-program",
      "label": {
        "zh": "全球项目群",
        "en": "Global Program"
      },
      "desc": {
        "zh": "跨多个地区和业务线的大型转型项目。典型团队 30-80 人，周期 12-36 个月。",
        "en": "Large-scale transformation across multiple regions and business lines. Typical team 30-80, duration 12-36 months."
      },
      "teamComposition": {
        "zh": [
          "项目群总监 (1)",
          "区域交付负责人 (每区域 1)",
          "技术架构委员会 (3-5)",
          "工程师 (15-40)",
          "变革管理 (2-4)",
          "PMO (2-3)"
        ],
        "en": [
          "Program Director (1)",
          "Regional Delivery Leads (1 per region)",
          "Architecture Board (3-5)",
          "Engineers (15-40)",
          "Change Management (2-4)",
          "PMO (2-3)"
        ]
      },
      "cadence": {
        "zh": "日度区域站会、周度项目群同步、双周度指导委员会、季度执行评审",
        "en": "Daily regional standups, weekly program sync, bi-weekly steering committee, quarterly executive review"
      }
    }
  ],
