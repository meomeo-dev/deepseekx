  "brandPrinciples": [
    {
      "label": {
        "zh": "精准胜过华丽",
        "en": "Precision Over Polish"
      },
      "desc": {
        "zh": "我们的设计和文案以清晰和准确为首要目标。每一个视觉元素和每一个字都应该传达实质信息。",
        "en": "Our design and copy prioritize clarity and accuracy. Every visual element and every word should convey substance."
      }
    },
    {
      "label": {
        "zh": "工程可信度",
        "en": "Engineering Credibility"
      },
      "desc": {
        "zh": "我们是一家同时做战略和工程的公司。品牌传达应该在咨询的优雅与工程的可信之间找到平衡。",
        "en": "We are a company that does both strategy and engineering. Brand communication should balance consulting elegance with engineering credibility."
      }
    },
    {
      "label": {
        "zh": "全球与中国双引擎",
        "en": "Global-China Dual Engine"
      },
      "desc": {
        "zh": "我们的品牌必须同时在全球市场和中国市场具有吸引力。双语不是翻译，而是两种独立表达。",
        "en": "Our brand must appeal in both global and China markets. Bilingual is not translation — it's two independent expressions."
      }
    },
    {
      "label": {
        "zh": "以人为本的技术",
        "en": "Human-Centered Technology"
      },
      "desc": {
        "zh": "我们讨论技术，但始终以人的影响为落脚点——无论是客户团队、最终用户还是社会。",
        "en": "We discuss technology but always land on human impact — whether client teams, end users, or society."
      }
    }
  ],
