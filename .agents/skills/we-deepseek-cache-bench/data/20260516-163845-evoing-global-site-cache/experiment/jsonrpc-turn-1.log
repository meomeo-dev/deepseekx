ludes('--color-navy-900'), 'CSS has navy-900');\nassert(brandCSS.includes('--color-gold-500'), 'CSS has gold-500 (accent)');\nassert(brandCSS.includes('--color-accent'), 'CSS has --color-accent semantic token');\nassert(brandCSS.includes('--font-sans'), 'CSS has --font-sans');\nassert(brandCSS.includes('--font-display'), 'CSS has --font-display');\nassert(brandCSS.includes('--font-mono'), 'CSS has --font-mono');\nassert(brandCSS.includes('--fs-hero'), 'CSS has --fs-hero (clamp)');\nassert(brandCSS.includes('--nav-height'), 'CSS has --nav-height');\nassert(brandCSS.includes('--radius-'), 'CSS has radius tokens');\nassert(brandCSS.includes('--shadow-'), 'CSS has shadow tokens');\nassert(brandCSS.includes('--ease-'), 'CSS has easing tokens');\n\n// --- 5. JavaScript modules ---\nconsole.log('\\n5. JavaScript modules');\nconst i18nJS = await readText('src/js/i18n.js');\nassert(i18nJS.includes('data-lang'), 'i18n.js references data-lang');\nassert(i18nJS.includes('localStorage'), 'i18n.js uses localStorage for persistence');\n\nconst navJS = await readText('src/js/navigation.js');\nassert(navJS.includes('scroll'), 'navigation.js handles scroll');\nassert(navJS.includes('mobile'), 'navigation.js handles mobile');\n\nconst filterJS = await readText('src/js/filter.js');\nassert(filterJS.includes('filter-chip'), 'filter.js references filter-chip');\nassert(filterJS.includes('data-category'), 'filter.js references data-category');\n\n// --- 6. Business rules ---\nconsole.log('\\n6. Business rules');\n// Every capability must map to at least one industry's context via region coverage\nconst regionIds = regs.map((r) => r.id);\ninds.forEach((ind) => {\n  assert(Array.isArray(ind.regions) && ind.regions.length >= 1, `industry ${ind.id} covers >= 1 region`);\n  ind.regions.forEach((rid) => {\n    assert(regionIds.includes(rid), `industry ${ind.id} references valid region ${rid}`);\n  });\n});\n\n// Every case must reference valid industry, region, capability\nconst capIds = caps.map((c) => c.id);\nconst indIds = inds.map((i) => i.id);\ncas.forEach((c) => {\n  assert(indIds.includes(c.industry), `case ${c.id} industry ${c.industry} is valid`);\n  assert(regionIds.includes(c.region), `case ${c.id} region ${c.region} is valid`);\n  assert(capIds.includes(c.capability), `case ${c.id} capability ${c.capability} is valid`);\n});\n\n// Navigation must reference sections that exist in HTML\nnav.primary.forEach((item) => {\n  assert(html.includes(`id=\"${item.id}\"`), `nav item ${item.id} has matching section in HTML`);\n});\n\n// --- 7. Server binding ---\nconsole.log('\\n8. Server startup');\nconst serverJS = await readText('server.mjs');\nassert(serverJS.includes('0.0.0.0'), 'server binds to 0.0.0.0');\nassert(serverJS.includes('5173'), 'server uses port 5173');\nassert(serverJS.includes('src'), 'server serves from src/ directory');\n\n// --- 8. Package scripts ---\nconsole.log('\\n9. Package scripts');\nconst pkg = await readJson('package.json');\nassert(pkg.scripts && pkg.scripts.start, 'package.json has start script');\nassert(pkg.scripts && pkg.scripts.test, 'package.json has test script');\nassert(pkg.name === 'evoing-global-site', 'package name is evoing-global-site');\n\n// --- 9. First-party line count ---\nconsole.log('\\n10. First-party source lines');\nasync function countLines(relPath) {\n  const text = await readText(relPath);\n  return text.split('\\n').length;\n}\n\nlet totalLines = 0;\nconst srcFiles = [\n  'src/index.html',\n  'src/css/brand.css', 'src/css/layout.css', 'src/css/components.css', 'src/css/main.css',\n  'src/js/i18n.js', 'src/js/navigation.js', 'src/js/filter.js', 'src/js/main.js',\n  'src/data/navigation.json', 'src/data/capabilities.json', 'src/data/industries.json',\n  'src/data/regions.json', 'src/data/cases.json',\n  'server.mjs', 'scripts/validate.mjs'\n];\n\nfor (const f of srcFiles) {\n  const lines = await countLines(f);\n  totalLines += lines;\n  console.log(`  ${String(lines).padStart(5)}  ${f}`);\n}\n\nconsole.log(`  -----  ----------`);\nconsole.log(`  ${String(totalLines).padStart(5)}  TOTAL first-party source lines`);\n\n// --- Summary ---\nconsole.log(`\\n=== Validation Summary ===`);\nconsole.log(`  Checks: ${checks}`);\nconsole.log(`  Passed: ${checks - failures}`);\nconsole.log(`  Failed: ${failures}`);\n\nif (totalLines < 10000) {\n  console.log(`\\n  WARNING: first-party lines (${totalLines}) below 10,000 target.`);\n}\n\nif (failures > 0) {\n  console.log('\\n  Validation FAILED.');\n  process.exit(1);\n} else {\n  console.log('\\n  Validation PASSED.');\n}\n\n// Note: server binding test is omitted because it would conflict.\n// Manual verification: `npm start` then visit http://0.0.0.0:5173\nENDOFFILE"}],"aggregatedOutput":null,"exitCode":0,"durationMs":0},"threadId":"019e2ff1-213e-7f10-918e-56ff4313a1e6","turnId":"019e2ff1-2158-7022-890f-5d1e73def79a","completedAtMs":1778921943642}}
