< {"method":"item/started","params":{"item":{"type":"commandExecution","id":"call_00_8f8Q8aZAo4JO0rhMgDfV8768","command":"/bin/bash -lc \"cat > /bench/20260516-163845-evoing-global-site-cache/workspace/src/index.html << 'ENDOFFILE'\n<\"'!DOCTYPE html>\n<html lang=\"zh\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Evoing — 智能及代码，代码及智能</title>\n  <meta name=\"description\" content=\"Evoing is a global consultancy at the intersection of intelligence and code. AI strategy, code modernization, operating model design — from Shanghai to New York.\">\n  <link rel=\"icon\" type=\"image/svg+xml\" href=\"data:image/svg+xml,<svg xmlns='\"'http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='4' fill='%230A1220'/><text x='16' y='22' text-anchor='middle' fill='%23C9A96E' font-family='Georgia,serif' font-size='18' font-weight='bold'>E</text></svg>\\\">\n  <link rel=\\\"stylesheet\\\" href=\\\"css/main.css\\\">\n  <style>\n    @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }\n    @keyframes fadeInUp { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }\n  </style>\n</head>\n<body>\n\n  <\"'!-- ========== NAVIGATION ========== -->\n  <nav class=\"nav\" role=\"navigation\" aria-label=\"Main navigation\">\n    <div class=\"nav__inner\">\n      <a href=\"#\" class=\"nav__brand\" aria-label=\"Evoing Home\">\n        Evo<span class=\"nav__brand-accent\">ing</span>\n      </a>\n\n      <div class=\"nav__links\" id=\"nav-links\">\n        <a class=\"nav__link\" data-target=\"capabilities\" href=\"#capabilities\">\n          <span data-lang=\"zh\">核心能力</span>\n          <span data-lang=\"en\" class=\"lang-hidden\">Capabilities</span>\n        </a>\n        <a class=\"nav__link\" data-target=\"industries\" href=\"#industries\">\n          <span data-lang=\"zh\">行业专长</span>\n          <span data-lang=\"en\" class=\"lang-hidden\">Industries</span>\n        </a>\n        <a class=\"nav__link\" data-target=\"insights\" href=\"#insights\">\n          <span data-lang=\"zh\">洞见</span>\n          <span data-lang=\"en\" class=\"lang-hidden\">Insights</span>\n        </a>\n        <a class=\"nav__link\" data-target=\"careers\" href=\"#careers\">\n          <span data-lang=\"zh\">招贤纳士</span>\n          <span data-lang=\"en\" class=\"lang-hidden\">Careers</span>\n        </a>\n        <a class=\"nav__link\" data-target=\"contact\" href=\"#contact\">\n          <span data-lang=\"zh\">联系我们</span>\n          <span data-lang=\"en\" class=\"lang-hidden\">Contact</span>\n        </a>\n      </div>\n\n      <div class=\"nav__actions\">\n        <button class=\"nav__lang-toggle\" id=\"lang-toggle\" aria-label=\"Switch language\">EN</button>\n        <button class=\"nav__mobile-toggle\" id=\"mobile-toggle\" aria-label=\"Toggle menu\" aria-expanded=\"false\">\n          <span></span><span></span><span></span>\n        </button>\n      </div>\n    </div>\n  </nav>\n\n  <!-- ========== HERO ========== -->\n  <section class=\"hero\" id=\"hero\">\n    <div class=\"hero__bg\"></div>\n    <div class=\"hero__grid\"></div>\n    <div class=\"container\" style=\"position:relative;z-index:2;\">\n      <div class=\"hero__content\">\n        <h1 class=\"hero__tagline-zh\">\n          <span data-lang=\"zh\">智能<em>及</em>代码，代码<em>及</em>智能</span>\n          <span data-lang=\"en\" class=\"lang-hidden\">Intelligence <em>&amp;</em> Code, Code <em>&amp;</em> Intelligence</span>\n        </h1>\n        <p class=\"hero__tagline-en\">\n          <span data-lang=\"zh\">智慧与工程的交汇点</span>\n          <span data-lang=\"en\" class=\"lang-hidden\">Where strategy meets engineering</span>\n        </p>\n        <p class=\"hero__desc\">\n          <span data-lang=\"zh\">Evoing 是一家全球商业咨询公司。我们帮助世界领先的企业在 AI 时代重塑战略、现代化代码资产、并设计面向未来的运营模式。从上海到纽约，从新加坡到伦敦——我们交付可落地的变革。</span>\n          <span data-lang=\"en\" class=\"lang-hidden\">Evoing is a global business consultancy. We help the world'\"'s leading enterprises reshape strategy, modernize code assets, and design future-ready operating models in the AI era. From Shanghai to New York, Singapore to London — we deliver change that sticks.</span>\n        </p>\n        <div class=\\\"hero__actions\\\">\n          <a href=\\\"#capabilities\\\" class=\\\"btn btn--primary btn--lg\\\" data-target=\\\"capabilities\\\">\n            <span data-lang=\\\"zh\\\">了解我们的能力</span>\n            <span data-lang=\\\"en\\\" class=\\\"lang-hidden\\\">Explore Capabilities</span>\n          </a>\n          <a href=\\\"#contact\\\" class=\\\"btn btn--outline-inverse btn--lg\\\" data-target=\\\"contact\\\">\n            <span data-lang=\\\"zh\\\">联系我们</span>\n            <span data-lang=\\\"en\\\" class=\\\"lang-hidden\\\">Get in Touch</span>\n          </a>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <\"'!-- ========== STATS BANNER ========== -->\n  <section class=\"section--alt\">\n    <div class=\"container\">\n      <div class=\"stats-banner\">\n        <div class=\"stat-item\">\n          <div class=\"stat-item__value\">500+</div>\n          <div class=\"stat-item__label\">\n            <span data-lang=\"zh\">全球顾问</span>\n            <span data-lang=\"en\" class=\"lang-hidden\">Global Consultants</span>\n          </div>\n        </div>\n        <div class=\"stat-item\">\n          <div class=\"stat-item__value\">14</div>\n          <div class=\"stat-item__label\">\n            <span data-lang=\"zh\">全球办公室</span>\n            <span data-lang=\"en\" class=\"lang-hidden\">Global Offices</span>\n          </div>\n        </div>\n        <div class=\"stat-item\">\n          <div class=\"stat-item__value\">200+</div>\n          <div class=\"stat-item__label\">\n            <span data-lang=\"zh\">企业客户</span>\n            <span data-lang=\"en\" class=\"lang-hidden\">Enterprise Clients</span>\n          </div>\n        </div>\n        <div class=\"stat-item\">\n          <div class=\"stat-item__value\">8</div>\n          <div class=\"stat-item__label\">\n            <span data-lang=\"zh\">行业覆盖</span>\n            <span data-lang=\"en\" class=\"lang-hidden\">Industry Verticals</span>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <!-- ========== CAPABILITIES ========== -->\n  <section class=\"section\" id=\"capabilities\">\n    <div class=\"container\">\n      <div class=\"section-header\">\n        <p class=\"section-header__label\">\n          <span data-lang=\"zh\">核心能力</span>\n          <span data-lang=\"en\" class=\"lang-hidden\">Capabilities</span>\n        </p>\n        <h2 class=\"section-header__title\">\n          <span data-lang=\"zh\">智能驱动，代码落地</span>\n          <span data-lang=\"en\" class=\"lang-hidden\">Intelligence-Driven, Code-Proven</span>\n        </h2>\n        <p class=\"section-header__desc\">\n          <span data-lang=\"zh\">我们跨越战略咨询与技术实现的鸿沟。六大核心能力覆盖从蓝图到上线的全周期。</span>\n          <span data-lang=\"en\" class=\"lang-hidden\">We bridge the gap between strategic advisory and technical implementation. Six core capabilities cover the full lifecycle from blueprint to production.</span>\n        </p>\n      </div>\n\n      <div class=\"filter-bar\" data-filter-target=\".card\">\n        <button class=\"filter-chip filter-chip--active\" data-filter=\"all\">\n          <span data-lang=\"zh\">全部</span>\n          <span data-lang=\"en\" class=\"lang-hidden\">All</span>\n        </button>\n        <button class=\"filter-chip\" data-filter=\"ai-strategy\">AI</button>\n        <button class=\"filter-chip\" data-filter=\"code-modernization\">\n          <span data-lang=\"zh\">代码</span>\n          <span data-lang=\"en\" class=\"lang-hidden\">Code</span>\n        </button>\n        <button class=\"filter-chip\" data-filter=\"operating-model\">\n          <span data-lang=\"zh\">运营</span>\n          <span data-lang=\"en\" class=\"lang-hidden\">Ops</span>\n        </button>\n        <button class=\"filter-chip\" data-filter=\"data-intelligence\">\n          <span data-lang=\"zh\">数据</span>\n          <span data-lang=\"en\" class=\"lang-hidden\">Data</span>\n        </button>\n        <button class=\"filter-chip\" data-filter=\"cyber-resilience\">\n          <span data-lang=\"zh\">安全</span>\n          <span data-lang=\"en\" class=\"lang-hidden\">Security</span>\n        </button>\n        <button class=\"filter-chip\" data-filter=\"strategy-advisory\">\n          <span data-lang=\"zh\">战略</span>\n          <span data-lang=\"en\" class=\"lang-hidden\">Strategy</span>\n        </button>\n      </div>\n\n      <div class=\"grid-3\" id=\"capabilities-grid\">\n        <!-- Card 1: AI Strategy -->\n        <article class=\"card\" data-category=\"ai-strategy\">\n          <div class=\"card__icon\">&#x1F9E0;</div>\n          <h3 class=\"card__title\">\n            <span data-lang=\"zh\">AI 战略与转型</span>\n            <span data-lang=\"en\" class=\"lang-hidden\">AI Strategy &amp; Transformation</span>\n          </h3>\n          <p class=\"card__desc\">\n            <span data-lang=\"zh\">从战略规划到落地执行，帮助企业构建 AI 原生竞争力。</span>\n            <span data-lang=\"en\" class=\"lang-hidden\">From strategic planning to execution, we help enterprises build AI-native competitiveness.</span>\n          </p>\n          <div class=\"card__subs\">\n            <span class=\"card__sub\">\n              <span data-lang=\"zh\">AI 成熟度评估</span>\n              <span data-lang=\"en\" class=\"lang-hidden\">AI Maturity Assessment</span>\n            </span>\n            <span class=\"card__sub\">\n              <span data-lang=\"zh\">生成式 AI 落地</span>\n              <span data-lang=\"en\" class=\"lang-hidden\">Generative AI Implementation</span>\n            </span>\n            <span class=\"card__sub\">\n              <span data-lang=\"zh\">AI 治理与合规</span>\n              <span data-lang=\"en\" class=\"lang-hidden\">AI Governance &amp; Compliance</span>\n            </span>\n            <span class=\"card__sub\">\n              <span data-lang=\"zh\">机器学习平台</span>\n              <span data-lang=\"en\" class=\"lang-hidden\">ML Platform Engineering</span>\n            </span>\n          </div>\n        </article>\n\n        <!-- Card 2: Code Modernization -->\n        <article class=\"card\" data-category=\"code-modernization\">\n          <div class=\"card__icon\">&#x2328;</div>\n          <h3 class=\"card__title\">\n            <span data-lang=\"zh\">代码现代化</span>\n            <span data-lang=\"en\" class=\"lang-hidden\">Code Modernization</span>\n          </h3>\n          <p class=\"card__desc\">\n            <span data-lang=\"zh\">通过平台工程、架构演进和遗留系统改造，释放软件资产的长期价值。</span>\n            <span data-lang=\"en\" class=\"lang-hidden\">Unlock the long-term value of software assets through platform engineering, architecture evolution, and legacy modernization.</span>\n          </p>\n          <div class=\"card__subs\">\n            <span class=\"card__sub\">\n              <span data-lang=\"zh\">平台工程</span>\n              <span data-lang=\"en\" class=\"lang-hidden\">Platform Engineering</span>\n            </span>\n            <span class=\"card__sub\">\n              <span data-lang=\"zh\">遗留系统迁移</span>\n              <span data-lang=\"en\" class=\"lang-hidden\">Legacy System Migration</span>\n            </span>\n            <span class=\"card__sub\">\n              <span data-lang=\"zh\">云原生架构</span>\n              <span data-lang=\"en\" class=\"lang-hidden\">Cloud-Native Architecture</span>\n            </span>\n            <span class=\"card__sub\">\n              <span data-lang=\"zh\">DevSecOps 转型</span>\n              <span data-lang=\"en\" class=\"lang-hidden\">DevSecOps Transformation</span>\n            </span>\n          </div>\n        </article>\n\n        <!-- Card 3: Operating Model -->\n        <article class=\"card\" data-category=\"operating-model\">\n          <div class=\"card__icon\">&#x2699;</div>\n          <h3 class=\"card__title\">\n            <span data-lang=\"zh\">运营模式设计</span>\n            <span data-lang=\"en\" class=\"lang-hidden\">Operating Model Design</span>\n          </h3>\n          <p class=\"card__desc\">\n            <span data-lang=\"zh\">重塑组织架构、流程与人才体系，使技术真正驱动业务增长。</span>\n            <span data-lang=\"en\" class=\"lang-hidden\">Reshape organizational structure, processes, and talent systems so technology genuinely drives business growth.</span>\n          </p>\n          <div class=\"card__subs\">\n            <span class=\"card__sub\">\n              <span data-lang=\"zh\">技术组织设计</span>\n              <span data-lang=\"en\" class=\"lang-hidden\">Technology Org Design</span>\n            </span>\n            <span class=\"card__sub\">\n              <span data-lang=\"zh\">敏捷与产品运营</span>\n              <span data-lang=\"en\" class=\"lang-hidden\">Agile &amp; Product Operations</span>\n            </span>\n            <span class=\"card__sub\">\n              <span data-lang=\"zh\">数字化人才战略</span>\n              <span data-lang=\"en\" class=\"lang-hidden\">Digital Talent Strategy</span>\n            </span>\n            <span class=\"card__sub\">\n              <span data-lang=\"zh\">变革管理</span>\n              <span data-lang=\"en\" class=\"lang-hidden\">Change Management</span>\n            </span>\n          </div>\n        </article>\n\n        <!-- Card 4: Data Intelligence -->\n        <article class=\"card\" data-category=\"data-intelligence\">\n          <div class=\"card__icon\">&#x1F4CA;</div>\n          <h3 class=\"card__title\">\n            <span data-lang=\"zh\">数据智能</span>\n            <span data-lang=\"en\" class=\"lang-hidden\">Data Intelligence</span>\n          </h3>\n          <p class=\"card__desc\">\n            <span data-lang=\"zh\">打通数据孤岛，构建可扩展的数据平台与智能决策体系。</span>\n            <span data-lang=\"en\" class=\"lang-hidden\">Break down data silos, build scalable data platforms and intelligent decision-making systems.</span>\n          </p>\n          <div class=\"card__subs\">\n            <span class=\"card__sub\">\n              <span data-lang=\"zh\">数据战略</span>\n              <span data-lang=\"en\" class=\"lang-hidden\">Data Strategy</span>\n            </span>\n            <span class=\"card__sub\">\n              <span data-lang=\"zh\">数据平台架构</span>\n              <span data-lang=\"en\" class=\"lang-hidden\">Data Platform Architecture</span>\n            </span>\n            <span class=\"card__sub\">\n              <span data-lang=\"zh\">高级分析</span>\n              <span data-lang=\"en\" class=\"lang-hidden\">Advanced Analytics</span>\n            </span>\n            <span class=\"card__sub\">\n              <span data-lang=\"zh\">数据治理</span>\n              <span data-lang=\"en\" class=\"lang-hidden\">Data Governance</span>\n            </span>\n          </div>\n        </article>\n\n        <!-- Card 5: Cyber Resilience -->\n        <article class=\"card\" data-category=\"cyber-resilience\">\n          <div class=\"card__icon\">&#x1F6E1;</div>\n          <h3 class=\"card__title\">\n            <span data-lang=\"zh\">网络韧性</span>\n            <span data-lang=\"en\" class=\"lang-hidden\">Cyber Resilience</span>\n          </h3>\n          <p class=\"card__desc\">\n            <span data-lang=\"zh\">在日益复杂的威胁环境中，构建从预防到恢复的全周期安全能力。</span>\n            <span data-lang=\"en\" class=\"lang-hidden\">Build full-cycle security capabilities from prevention to recovery in an increasingly complex threat landscape.</span>\n          </p>\n          <div class=\"card__subs\">\n            <span class=\"card__sub\">\n              <span data-lang=\"zh\">安全架构评估</span>\n              <span data-lang=\"en\" class=\"lang-hidden\">Security Architecture Assessment</span>\n            </span>\n            <span class=\"card__sub\">\n              <span data-lang=\"zh\">零信任实施</span>\n              <span data-lang=\"en\" class=\"lang-hidden\">Zero Trust Implementation</span>\n            </span>\n            <span class=\"card__sub\">\n              <span data-lang=\"zh\">事件响应</span>\n              <span data-lang=\"en\" class=\"lang-hidden\">Incident Response</span>\n            </span>\n            <span class=\"card__sub\">\n              <span data-lang=\"zh\">合规与审计</span>\n              <span data-lang=\"en\" class=\"lang-hidden\">Compliance &amp; Audit</span>\n            </span>\n          </div>\n        </article>\n\n        <!-- Card 6: Strategy Advisory -->\n        <article class=\"card\" data-category=\"strategy-advisory\">\n          <div class=\"card__icon\">&#x1F9ED;</div>\n          <h3 class=\"card__title\">\n            <span data-lang=\"zh\">战略咨询</span>\n            <span data-lang=\"en\" class=\"lang-hidden\">Strategy Advisory</span>\n          </h3>\n          <p class=\"card__desc\">\n            <span data-lang=\"zh\">结合行业洞察与技术视野，为企业制定可执行的数字化增长战略。</span>\n            <span data-lang=\"en\" class=\"lang-hidden\">Combine industry insight with technology vision to craft executable digital growth strategies.</span>\n          </p>\n          <div class=\"card__subs\">\n            <span class=\"card__sub\">\n              <span data-lang=\"zh\">数字化战略</span>\n              <span data-lang=\"en\" class=\"lang-hidden\">Digital Strategy</span>\n            </span>\n            <span class=\"card__sub\">\n              <span data-lang=\"zh\">技术尽职调查</span>\n              <span data-lang=\"en\" class=\"lang-hidden\">Technology Due Diligence</span>\n            </span>\n            <span class=\"card__sub\">\n              <span data-lang=\"zh\">创新蓝图</span>\n              <span data-lang=\"en\" class=\"lang-hidden\">Innovation Blueprint</span>\n            </span>\n            <span class=\"card__sub\">\n              <span data-lang=\"zh\">并购整合</span>\n              <span data-lang=\"en\" class=\"lang-hidden\">M&amp;A Integration</span>\n            </span>\n          </div>\n        </article>\n      </div>\n    </div>\n  </section>\n\n  <!-- ========== CASE HIGHLIGHTS ========== -->\n  <section class=\"section section--dark\" id=\"cases\">\n    <div class=\"container\">\n      <div class=\"section-header\">\n        <p class=\"section-header__label\">\n          <span data-lang=\"zh\">精选案例</span>\n          <span data-lang=\"en\" class=\"lang-hidden\">Case Highlights</span>\n        </p>\n        <h2 class=\"section-header__title\">\n          <span data-lang=\"zh\">交付成果，而非报告</span>\n          <span data-lang=\"en\" class=\"lang-hidden\">We Deliver Outcomes, Not Decks</span>\n        </h2>\n      </div>\n\n      <div class=\"grid-3\">\n        <!-- Case 1 -->\n        <article class=\"case-card\">\n          <p class=\"case-card__industry\">Financial Services</p>\n          <h3 class=\"case-card__title\">\n            <span data-lang=\"zh\">某全球银行 AI 平台构建</span>\n            <span data-lang=\"en\" class=\"lang-hidden\">Global Bank AI Platform Build</span>\n          </h3>\n          <p class=\"case-card__summary\">\n            <span data-lang=\"zh\">为一家欧洲顶级银行设计并交付企业级 AI 平台，覆盖 12 个业务线，模型推理延迟降低 60%。</span>\n            <span data-lang=\"en\" class=\"lang-hidden\">Designed and delivered an enterprise AI platform for a top European bank, covering 12 business lines with 60% lower model inference latency.</span>\n          </p>\n          <div class=\"case-card__metrics\">\n            <div>\n              <div class=\"case-card__metric-value\">60%</div>\n              <div class=\"case-card__metric-label\">\n                <span data-lang=\"zh\">推理延迟降低</span>\n                <span data-lang=\"en\" class=\"lang-hidden\">Latency Reduction</span>\n              </div>\n            </div>\n            <div>\n              <div class=\"case-card__metric-value\">12</div>\n              <div class=\"case-card__metric-label\">\n                <span data-lang=\"zh\">覆盖业务线</span>\n                <span data-lang=\"en\" class=\"lang-hidden\">Business Lines</span>\n              </div>\n            </div>\n          </div>\n        </article>\n\n        <!-- Case 2 -->\n        <article class=\"case-card\">\n          <p class=\"case-card__industry\">Retail &amp; Consumer</p>\n          <h3 class=\"case-card__title\">\n            <span data-lang=\"zh\">零售巨头云原生迁移</span>\n            <span data-lang=\"en\" class=\"lang-hidden\">Retail Giant Cloud-Native Migration</span>\n          </h3>\n          <p class=\"case-card__summary\">\n            <span data-lang=\"zh\">协助一家北美零售巨头将单体遗留系统迁移至云原生微服务架构，部署频率提升 8 倍。</span>\n            <span data-lang=\"en\" class=\"lang-hidden\">Helped a North American retail giant migrate from monolith to cloud-native microservices, increasing deployment frequency 8x.</span>\n          </p>\n          <div class=\"case-card__metrics\">\n            <div>\n              <div class=\"case-card__metric-value\">8x</div>\n              <div class=\"case-card__metric-label\">\n                <span data-lang=\"zh\">部署频率提升</span>\n                <span data-lang=\"en\" class=\"lang-hidden\">Deploy Frequency</span>\n              </div>\n            </div>\n            <div>\n              <div class=\"case-card__metric-value\">99.99%</div>\n              <div class=\"case-card__metric-label\">\n                <span data-lang=\"zh\">系统可用性</span>\n                <span data-lang=\"en\" class=\"lang-hidden\">Availability</span>\n              </div>\n            </div>\n          </div>\n        </article>\n\n        <!-- Case 3 -->\n        <article class=\"case-card\">\n          <p class=\"case-card__industry\">Advanced Manufacturing</p>\n          <h3 class=\"case-card__title\">\n            <span data-lang=\"zh\">先进制造运营模式重塑</span>\n            <span data-lang=\"en\" class=\"lang-hidden\">Manufacturing Op Model Redesign</span>\n          </h3>\n          <p class=\"case-card__summary\">\n            <span data-lang=\"zh\">为一家中国先进制造企业重塑技术组织，从职能型结构转型为产品型组织，交付周期缩短 40%。</span>\n            <span data-lang=\"en\" class=\"lang-hidden\">Reshaped the technology organization for a Chinese advanced manufacturer, transforming from functional to product-oriented structure, reducing delivery cycle by 40%.</span>\n          </p>\n          <div class=\"case-card__metrics\">\n            <div>\n              <div class=\"case-card__metric-value\">40%</div>\n              <div class=\"case-card__metric-label\">\n                <span data-lang=\"zh\">交付周期缩短</span>\n                <span data-lang=\"en\" class=\"lang-hidden\">Cycle Reduction</span>\n              </div>\n            </div>\n            <div>\n              <div class=\"case-card__metric-value\">+35%</div>\n              <div class=\"case-card__metric-label\">\n                <span data-lang=\"zh\">工程师满意度</span>\n                <span data-lang=\"en\" class=\"lang-hidden\">Eng. Satisfaction</span>\n              </div>\n            </div>\n          </div>\n        </article>\n      </div>\n    </div>\n  </section>\n\n  <!-- ========== INDUSTRIES ========== -->\n  <section class=\"section\" id=\"industries\">\n    <div class=\"container\">\n      <div class=\"section-header\">\n        <p class=\"section-header__label\">\n          <span data-lang=\"zh\">行业专长</span>\n          <span data-lang=\"en\" class=\"lang-hidden\">Industries</span>\n        </p>\n        <h2 class=\"section-header__title\">\n          <span data-lang=\"zh\">深谙行业，才懂变革</span>\n          <span data-lang=\"en\" class=\"lang-hidden\">Deep Industry Knowledge Drives Real Change</span>\n        </h2>\n      </div>\n\n      <div class=\"grid-4\" style=\"text-align:center;\">\n        <div class=\"region-card\">\n          <span data-lang=\"zh\" style=\"font-size:var(--fs-h3);\">金融服务</span>\n          <span data-lang=\"en\" class=\"lang-hidden\" style=\"font-size:var(--fs-h3);\">Financial Services</span>\n        </div>\n        <div class=\"region-card\">\n          <span data-lang=\"zh\" style=\"font-size:var(--fs-h3);\">零售与消费品</span>\n          <span data-lang=\"en\" class=\"lang-hidden\" style=\"font-size:var(--fs-h3);\">Retail &amp; Consumer</span>\n        