< {"method":"item/started","params":{"item":{"type":"commandExecution","id":"call_03_lDW6X9P8HQFKnRF0WYEc8474","command":"/bin/bash -lc \"cat > /bench/20260516-163845-evoing-global-site-cache/workspace/src/js/main.js << 'ENDOFFILE'\n/**\n * Evoing main entry — orchestrates modules after DOM ready.\n */\n(function () {\n  function boot() {\n    /* Navigation already self-inits */\n    /* I18n already self-inits */\n    /* Filter already self-inits */\n\n    /* Animate stats counters on scroll */\n    const stats = document.querySelectorAll('.stat-item__value');\n    if (stats.length > 0) {\n      const observer = new IntersectionObserver((entries) => {\n        entries.forEach((entry) => {\n          if (entry.isIntersecting) {\n            entry.target.style.animation = 'fadeIn 0.6s ease-out forwards';\n            observer.unobserve(entry.target);\n          }\n        });\n      }, { threshold: 0.5 });\n\n      stats.forEach((el) => {\n        el.style.opacity = '0';\n        observer.observe(el);\n      });\n    }\n\n    /* Reveal cards on scroll */\n    const cards = document.querySelectorAll('.card, .case-card, .region-card');\n    if (cards.length > 0) {\n      const cardObserver = new IntersectionObserver((entries) => {\n        entries.forEach((entry) => {\n          if (entry.isIntersecting) {\n            entry.target.style.animation = 'fadeInUp 0.5s ease-out forwards';\n            cardObserver.unobserve(entry.target);\n          }\n        });\n      }, { threshold: 0.15, rootMargin: '0px 0px -30px 0px' });\n\n      cards.forEach((el) => {\n        el.style.opacity = '0';\n        el.style.transform = 'translateY(20px)';\n        cardObserver.observe(el);\n      });\n    }\n\n    console.log('[Evoing] Global site ready.');\n  }\n\n  if (document.readyState === 'loading') {\n    document.addEventListener('DOMContentLoaded', boot);\n  } else {\n    boot();\n  }\n})();\nENDOFFILE\"","cwd":"/bench/20260516-163845-evoing-global-site-cache/workspace","processI