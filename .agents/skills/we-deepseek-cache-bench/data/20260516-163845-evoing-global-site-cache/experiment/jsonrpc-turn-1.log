isplay: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: var(--space-3xl);\n}\n\n.contact-info__title {\n  font-family: var(--font-display);\n  font-size: var(--fs-h2);\n  margin-bottom: var(--space-md);\n}\n\n.contact-info__desc {\n  color: var(--color-text-secondary);\n  line-height: var(--lh-relaxed);\n  margin-bottom: var(--space-xl);\n}\n\n.contact-info__regions {\n  display: flex;\n  flex-direction: column;\n  gap: var(--space-md);\n}\n\n.contact-region {\n  padding: var(--space-md);\n  border-left: 2px solid var(--color-border);\n}\n\n.contact-region__name {\n  font-weight: var(--fw-semibold);\n  margin-bottom: var(--space-2xs);\n}\n\n.contact-region__email {\n  font-family: var(--font-mono);\n  font-size: var(--fs-small);\n  color: var(--color-accent);\n}\n\n.contact-form {\n  display: flex;\n  flex-direction: column;\n  gap: var(--space-md);\n}\n\n.contact-form__row {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: var(--space-md);\n}\n\n.contact-form__input {\n  width: 100%;\n  padding: var(--space-sm) var(--space-md);\n  border: 1px solid var(--color-border);\n  border-radius: var(--radius-sm);\n  font-family: var(--font-sans);\n  font-size: var(--fs-body);\n  color: var(--color-text);\n  background: var(--color-bg-alt);\n  transition: border-color var(--duration-fast) var(--ease-out);\n}\n\n.contact-form__input:focus {\n  outline: none;\n  border-color: var(--color-accent);\n}\n\n.contact-form__input--textarea {\n  resize: vertical;\n  min-height: 120px;\n}\n\n@media (max-width: 768px) {\n  .contact-grid {\n    grid-template-columns: 1fr;\n  }\n\n  .contact-form__row {\n    grid-template-columns: 1fr;\n  }\n}\nENDOFFILE\"","cwd":"/bench/20260516-163845-evoing-global-site-cache/workspace","processId":"18815","source":"unifiedExecStartup","status":"inProgress","commandActions":[{"type":"unknown","command":"cat > /bench/20260516-163845-evoing-global-site-cache/workspace/src/css/main.css << 'ENDOFFILE'\n/* =======================================