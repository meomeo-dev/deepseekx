t = await readText(relPath);\n  return text.split('\\\\n').length;\n}\n\nlet totalLines = 0;\nconst srcFiles = [\n  'src/index.html',\n  'src/css/brand.css', 'src/css/layout.css', 'src/css/components.css', 'src/css/main.css',\n  'src/js/i18n.js', 'src/js/navigation.js', 'src/js/filter.js', 'src/js/main.js',\n  'src/data/navigation.json', 'src/data/capabilities.json', 'src/data/industries.json',\n  'src/data/regions.json', 'src/data/cases.json',\n  'server.mjs', 'scripts/validate.mjs'\n];\n\nfor (const f of srcFiles) {\n  const lines = await countLines(f);\n  totalLines += lines;\n  console.log(\"'`  ${String(lines).padStart(5)}  ${f}`);\n}\n\nconsole.log(`  -----  ----------`);\nconsole.log(`  ${String(totalLines).padStart(5)}  TOTAL first-party source lines`);\n\n// --- Summary ---\nconsole.log(`'\"\\\\n=== Validation Summary ===\"'`);\nconsole.log(`  Checks: ${checks}`);\nconsole.log(`  Passed: ${checks - failures}`);\nconsole.log(`  Failed: ${failures}`);\n\nif (totalLines < 10000) {\n  console.log(`'\"\\\\n  WARNING: first-party lines (\"'${totalLines}) below 10,000 target.`);\n}\n\nif (failures > 0) {\n  console.log('\"'\\\\n  Validation FAILED.');\n  process.exit(1);\n} else {\n  console.log('\\\\n  Validation PASSED.');\n}\n\n// Note: server binding test is omitted because it would conflict.\n// Manual verification: \"'`npm start` then visit http://0.0.0.0:5173\nENDOFFILE'","cwd":"/bench/20260516-163845-evoing-global-site-cache/workspace","processId":"99971","source":"unifiedExecStartup","status":"inProgress","commandActions":[{"type":"unknown","command":"cat > /bench/20260516-163845-evoing-global-site-cache/workspace/scripts/validate.mjs << 'ENDOFFILE'\n/**\n * Evoing Site Validation Script\n * Checks: file existence, JSON validity, HTML structure, i18n coverage,\n * CSS tokens, server binding, and business rules.\n */\nimport { readFile, access } from 'node:fs/promises';\nimport { join, dirname } from 'node:path';\nimport { fileURLToPath } from 'node:url';\