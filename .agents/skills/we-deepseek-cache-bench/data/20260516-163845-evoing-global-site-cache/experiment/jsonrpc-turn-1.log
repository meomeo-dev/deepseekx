nts.css exists');\nassert(await fileExists('src/css/main.css'), 'src/css/main.css exists');\nassert(await fileExists('src/js/i18n.js'), 'src/js/i18n.js exists');\nassert(await fileExists('src/js/navigation.js'), 'src/js/navigation.js exists');\nassert(await fileExists('src/js/filter.js'), 'src/js/filter.js exists');\nassert(await fileExists('src/js/main.js'), 'src/js/main.js exists');\nassert(await fileExists('src/data/navigation.json'), 'navigation.json exists');\nassert(await fileExists('src/data/capabilities.json'), 'capabilities.json exists');\nassert(await fileExists('src/data/industries.json'), 'industries.json exists');\nassert(await fileExists('src/data/regions.json'), 'regions.json exists');\nassert(await fileExists('src/data/cases.json'), 'cases.json exists');\n\n// --- 2. JSON data files valid ---\nconsole.log('\\\\n2. JSON validity & structure');\n\nlet nav, caps, inds, regs, cas;\ntry {\n  nav = await readJson('src/data/navigation.json');\n  assert(Array.isArray(nav.primary), 'navigation.primary is array');\n  assert(nav.primary.length >= 5, 'navigation.primary has >= 5 items');\n  assert(nav.footer && Array.isArray(nav.footer.legal), 'footer.legal is array');\n} catch (e) { assert(false, \"'`navigation.json: ${e.message}`); }\n\ntry {\n  caps = await readJson('\"'src/data/capabilities.json');\n  assert(Array.isArray(caps), 'capabilities is array');\n  assert(caps.length >= 6, 'capabilities has >= 6 items');\n  caps.forEach((c, i) => {\n    assert(c.id && c.label && c.label.zh && c.label.en, \"'`capability[${i}] has id + bilingual label`);\n    assert(c.summary && c.summary.zh && c.summary.en, `capability[${i}] has bilingual summary`);\n    assert(Array.isArray(c.subs) && c.subs.length >= 3, `capability[${i}] has >= 3 sub-capabilities`);\n  });\n} catch (e) { assert(false, `capabilities.json: ${e.message}`); }\n\ntry {\n  inds = await readJson('\"'src/data/industries.json');\n  assert(Array.isArray(inds), 'industries is array');\n  assert(inds.length >= 8, 'industries has >= 8 items');\n  inds.forEach((ind, i) => {\n    assert(ind.id && ind.label && ind.label.zh && ind.label.en, \"'`industry[${i}] has id + bilingual label`);\n  });\n} catch (e) { assert(false, `industries.json: ${e.message}`); }\n\ntry {\n  regs = await readJson('\"'src/data/regions.json');\n  assert(Array.isArray(regs), 'regions is array');\n  assert(regs.length === 3, 'regions has 3 items (apac, emea, amer)');\n  regs.forEach((r) => {\n    assert(Array.isArray(r.offices) && r.offices.length >= 4, \"'`region ${r.id} has >= 4 offices`);\n    const hubs = r.offices.filter((o) => o.hub);\n    assert(hubs.length >= 1, `region ${r.id} has >= 1 hub`);\n  });\n} catch (e) { assert(false, `regions.json: ${e.message}`); }\n\ntry {\n  cas = await readJson('\"'src/data/cases.json');\n  assert(Array.isArray(cas), 'cases is array');\n  assert(cas.length >= 3, 'cases has >= 3 items');\n  cas.forEach((c, i) => {\n    assert(c.id && c.title && c.title.zh && c.title.en, \"'`case[${i}] has id + bilingual title`);\n    assert(Array.isArray(c.metrics) && c.metrics.length >= 2, `case[${i}] has >= 2 metrics`);\n  });\n} catch (e) { assert(false, `cases.json: ${e.message}`); }\n\n// --- 3. HTML structure ---\nconsole.log('\"'\\\\n3. HTML structure');\nconst html = await readText('src/index.html');\nassert(html.includes('<\"'!DOCTYPE html>'\"'), 'HTML has DOCTYPE');\nassert(html.includes('<html lang='), 'HTML has lang attribute');\nassert(html.includes('智能及代码'), 'HTML contains tagline (zh)');\nassert(html.includes('Intelligence'), 'HTML contains tagline (en)');\nassert(html.includes('data-lang=\\\"zh\\\"'), 'HTML has zh data-lang attributes');\nassert(html.includes('data-lang=\\\"en\\\"'), 'HTML has en data-lang attributes');\nassert(html.includes('lang-toggle'), 'HTML has language toggle');\nassert(html.includes('nav__mobile-toggle'), 'HTML has mobile nav toggle');\nassert(html.includes('hero__tagline-zh'), 'HTML has hero section');\nassert(html.includes('id=\\\"capabilities\\\"'), 'HTML has capabilities section');\nassert(html.includes('id=\\\"industries\\\"'), 'HTML has industries section');\nassert(html.includes('id=\\\"insights\\\"'), 'HTML has insights section');\nassert(html.includes('id=\\\"careers\\\"'), 'HTML has careers section');\nassert(html.includes('id=\\\"contact\\\"'), 'HTML has contact section');\nassert(html.includes('id=\\\"regions\\\"'), 'HTML has regions section');\nassert(html.includes('footer'), 'HTML has footer');\n\n// --- 4. CSS design tokens ---\nconsole.log('\\\\n4. CSS design tokens');\nconst brandCSS = await readText('src/css/brand.css');\nassert(brandCSS.includes('--color-navy-900'), 'CSS has navy-900');\nassert(brandCSS.includes('--color-gold-500'), 'CSS has gold-500 (accent)');\nassert(brandCSS.includes('--color-accent'), 'CSS has --color-accent semantic token');\nassert(brandCSS.includes('--font-sans'), 'CSS has --font-sans');\nassert(brandCSS.includes('--font-display'), 'CSS has --font-display');\nassert(brandCSS.includes('--font-mono'), 'CSS has --font-mono');\nassert(brandCSS.includes('--fs-hero'), 'CSS has --fs-hero (clamp)');\nassert(brandCSS.includes('--nav-height'), 'CSS has --nav-height');\nassert(brandCSS.includes('--radius-'), 'CSS has radius tokens');\nassert(brandCSS.includes('--shadow-'), 'CSS has shadow tokens');\nassert(brandCSS.includes('--ease-'), 'CSS has easing tokens');\n\n// --- 5. JavaScript modules ---\nconsole.log('\\\\n5. JavaScript modules');\nconst i18nJS = await readText('src/js/i18n.js');\nassert(i18nJS.includes('data-lang'), 'i18n.js references data-lang');\nassert(i18nJS.includes('localStorage'), 'i18n.js uses localStorage for persistence');\n\nconst navJS = await readText('src/js/navigation.js');\nassert(navJS.includes('scroll'), 'navigation.js handles scroll');\nassert(navJS.includes('mobile'), 'navigation.js handles mobile');\n\nconst filterJS = await readText('src/js/filter.js');\nassert(filterJS.includes('filter-chip'), 'filter.js references filter-chip');\nass