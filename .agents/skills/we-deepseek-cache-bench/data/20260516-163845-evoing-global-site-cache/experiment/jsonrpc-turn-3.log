    if (pathsGrid) {\n        pathsGrid.innerHTML = (data.careerPaths||[]).map((p) =>\n          '<div class=\\\"path-card\\\"><p class=\\\"path-card__label\\\">'+escHtml(p.label[lang])+'</p><p class=\\\"path-card__desc\\\">'+escHtml(p.desc[lang])+'</p><div class=\\\"path-card__levels\\\">'+(p.levels[lang]||[]).map((lvl) => '<span class=\\\"path-card__level\\\">'+escHtml(lvl)+'</span>').join('')+'</div></div>'\n        ).join('');\n      }\n      if (jobsGrid) {\n        jobsGrid.innerHTML = (data.openings||[]).map((j) => {\n          const pathLabel = ((data.careerPaths||[]).find((p) => p.id === j.path) || {}).label || {};\n          return '<article class=\\\"job-card\\\" data-path=\\\"'+escHtml(j.path)+'\\\">'+\n            '<h4 class=\\\"job-card__title\\\">'+escHtml(j.title[lang])+'</h4>'+\n            '<div class=\\\"job-card__meta\\\">'+\n            '<span class=\\\"job-card__tag job-card__tag--location\\\">'+escHtml(j.location.replace(/-/g,' ').replace(/\\\\b\\\\w/g,c=>c.toUpperCase()))+'</span>'+\n            '<span class=\\\"job-card__tag job-card__tag--type\\\">'+escHtml(j.type[lang])+'</span>'+\n            '<span class=\\\"job-card__tag job-card__tag--path\\\">'+escHtml((pathLabel[lang]||j.path))+'</span>'+\n            '</div>'+\n            '<p class=\\\"job-card__summary\\\">'+escHtml(j.summary[lang])+'</p>'+\n            '</article>';\n        }).join('');\n      }\n      if (interviewEl) {\n        const stepsHTML = (data.interviewProcess.steps||[]).map((s,i) =>\n          '<div class=\\\"interview-step\\\"><div class=\\\"interview-step__num\\\">'+(i+1)+'</div><p class=\\\"interview-step__label\\\">'+escHtml(s.label[lang])+'</p><p class=\\\"interview-step__desc\\\">'+escHtml(s.desc[lang])+'</p></div>'\n        ).join('');\n        interviewEl.innerHTML =\n          '<h3 style=\\\"font-family:var(--font-display);font-size:var(--fs-h2);text-align:center;\\\">'+escHtml(data.interviewProcess.title[lang])+'</h3>'+\n          '<div class=\\\"interview-steps\\\">'+stepsHTML+'</div>';\n      }\n    } catch (e) { console.warn('[Evoing] Careers load failed:', e.message); }\n  }\n\n  async function embedIndustryDeepData() {\n    const el = document.getElementById('industry-deep-data');\n    if (\"'!el) return;\n    try {\n      const data = await fetchJSON('\"'data/industry-deep.json');\n      const inds = await fetchJSON('data/industries.json');\n      const labelMap = {}; inds.forEach((i) => { labelMap[i.id] = i.label; });\n      data.forEach((d) => { d.label = labelMap[d.id] || { zh: d.id, en: d.id }; });\n      el.textContent = JSON.stringify(data);\n    } catch (e) { console.warn('[Evoing] Industry deep data load failed:', e.message); }\n  }\n\n  if (document.readyState === 'loading') { document.addEventListener('DOMContentLoaded', boot); }\n  else { boot(); }\n})();\nENDOFFILE\"","cwd":"/bench/20260516-163845-evoing-global-site-cache/workspace","processId":"48112","source":"unifiedExecStartup","status":"inProgress","commandActions":[{"type":"unknown","command":"cat > /bench/20260516-163845-evoing-global-site-cache/workspace/src/js/main.js << 'ENDOFFILE'\n/**\n * Evoing main entry — orchestrates modules, fetches data-driven sections.\n */\n(function () {\n  async function boot() {\n    await Promise.all([\n      renderSolutions(),\n      renderServiceCatalog(),\n      renderCaseStudies(),\n      renderArticles(),\n      renderOffices(),\n      renderLeadership(),\n      renderCareers(),\n      embedIndustryDeepData()\n    ]);\n\n    /* Animate stats */\n    const stats = document.querySelectorAll('.stat-item__value');\n    if (stats.length > 0) {\n      const obs = new IntersectionObserver((e) => { e.forEach((en) => { if (en.isIntersecting) { en.target.style.animation = 'fadeIn 0.6s ease-out forwards'; obs.unobserve(en.target); } }); }, { threshold: 0.5 });\n      stats.forEach((el) => { el.style.opacity = '0'; obs.observe(el); });\n    }\n\n    /* Reveal cards */\n    const cards = document.querySelectorAll('.card,.case-study-card,.region-card,.leader-card,.insight-card,.article-card,.office-card,.job-card,.solution-card,.methodology-step,.value-card,.path-card');\n    if (cards.length > 0) {\n      const co = new IntersectionObserver((e) => { e.forEach((en) => { if (en.isIntersecting) { en.target.style.animation = 'fadeInUp 0.5s ease-out forwards'; co.unobserve(en.target); } }); }, { threshold: 0.15, rootMargin: '0px 0px -30px 0px' });\n      cards.forEach((el) => { el.style.opacity = '0'; el.style.transform = 'translateY(20px)'; co.observe(el); });\n    }\n\n    console.log('[Evoing] Global site ready.');\n  }\n\n  async function fetchJSON(path) {\n    const resp = await fetch(path);\n    if (!resp.ok) throw new Error(`Failed to load ${path}: ${resp.status}`);\n    return resp.json();\n  }\n\n  function escHtml(s) { return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/\"/g,'&quot;'); }\n\n  async function renderSolutions() {\n    const grid = document.getElementById('solutions-grid');\n    const dataEl = document.getElementById('solutions-data');\n    if (!grid || !dataEl) return;\n    try {\n      const data = await fetchJSON('data/solutions.json');\n      dataEl.textContent = JSON.stringify(data);\n      const lang = document.documentElement.lang || 'zh';\n      const frag = document.createDocumentFragment();\n      data.forEach((s) => {\n        const card = document.createElement('article');\n        card.className = 'solution-card';\n        card.dataset.solutionId = s.id;\n        card.dataset.caps = (s.relatedCapabilities || []).join(',');\n        card.innerHTML =\n          '<h3 class=\"solution-card__name\">' + escHtml(s.name[lang]) + '</h3>' +\n          '<p class=\"solution-card__problem\">' + escHtml(s.problem[lang]) + '</p>' +\n          '<div class=\"solution-card__modules\">' + (s.modules[lang] || []).map((m) => '<span class=\"solution-card__module\">' + escHtml(m) + '</span>').join('') + '</div>' +\n          '<p class