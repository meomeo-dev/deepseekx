< {"method":"item/started","params":{"item":{"type":"commandExecution","id":"call_01_3jABM0xDfCAK8K7Mynlf2030","command":"/bin/bash -lc \"cat > /bench/20260516-163845-evoing-global-site-cache/workspace/src/js/main.js << 'ENDOFFILE'\n/**\n * Evoing main entry — orchestrates modules, fetches data-driven sections.\n */\n(function () {\n  async function boot() {\n    await Promise.all([\n      renderSolutions(),\n      renderServiceCatalog(),\n      renderCaseStudies(),\n      renderArticles(),\n      renderOffices(),\n      renderLeadership(),\n      renderCareers(),\n      embedIndustryDeepData()\n    ]);\n\n    /* Animate stats */\n    const stats = document.querySelectorAll('.stat-item__value');\n    if (stats.length > 0) {\n      const obs = new IntersectionObserver((e) => { e.forEach((en) => { if (en.isIntersecting) { en.target.style.animation = 'fadeIn 0.6s ease-out forwards'; obs.unobserve(en.target); } }); }, { threshold: 0.5 });\n      stats.forEach((el) => { el.style.opacity = '0'; obs.observe(el); });\n    }\n\n    /* Reveal cards */\n    const cards = document.querySelectorAll('.card,.case-study-card,.region-card,.leader-card,.insight-card,.article-card,.office-card,.job-card,.solution-card,.methodology-step,.value-card,.path-card');\n    if (cards.length > 0) {\n      const co = new IntersectionObserver((e) => { e.forEach((en) => { if (en.isIntersecting) { en.target.style.animation = 'fadeInUp 0.5s ease-out forwards'; co.unobserve(en.target); } }); }, { threshold: 0.15, rootMargin: '0px 0px -30px 0px' });\n      cards.forEach((el) => { el.style.opacity = '0'; el.style.transform = 'translateY(20px)'; co.observe(el); });\n    }\n\n    console.log('[Evoing] Global site ready.');\n  }\n\n  async function fetchJSON(path) {\n    const resp = await fetch(path);\n    if (\"'!resp.ok) throw new Error(`Failed to load ${path}: ${resp.status}`);\n    return resp.json();\n  }\n\n  function escHtml(s) { return String(s).replace(/&/g,'\"'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/\\\"/g,'&quot;'); }\n\n  async function renderSolutions() {\n    const grid = document.getElementById('solutions-grid');\n    const dataEl = document.getElementById('solutions-data');\n    if (\"'!grid || !dataEl) return;\n    try {\n      const data = await fetchJSON('\"'data/solutions.json');\n      dataEl.textContent = JSON.stringify(data);\n      const lang = document.documentElement.lang || 'zh';\n      const frag = document.createDocumentFragment();\n      data.forEach((s) => {\n        const card = document.createElement('article');\n        card.className = 'solution-card';\n        card.dataset.solutionId = s.id;\n        card.dataset.caps = (s.relatedCapabilities || []).join(',');\n        card.innerHTML =\n          '<h3 class=\\\"solution-card__name\\\">' + escHtml(s.name[lang]) + '</h3>' +\n          '<p class=\\\"solution-card__problem\\\">' + escHtml(s.problem[lang]) + '</p>' +\n          '<div class=\\\"solution-card__modules\\\">' + (s.modules[lang] || []).map((m) => '<span class=\\\"solution-card__module\\\">' + escHtml(m) + '</span>').join('') + '</div>' +\n          '<p class=\\\"solution-card__outcomes\\\">' + escHtml(s.outcomes[lang]) + '</p>' +\n          '<div class=\\\"solution-card__metrics\\\">' + (s.metrics[lang] || []).slice(0,2).map((m) => '<span class=\\\"solution-card__metric\\\">' + escHtml(m) + '</span>').join('') + '</div>';\n        frag.appendChild(card);\n      });\n      grid.innerHTML = '';\n      grid.appendChild(frag);\n    } catch (e) { console.warn('[Evoing] Solutions load failed:', e.message); }\n  }\n\n  async function renderServiceCatalog() {\n    const grid = document.getElementById('service-grid');\n    if (\"'!grid) return;\n    try {\n      const catalog = await fetchJSON('\"'data/service-catalog.json');\n      const lang = document.documentElement.lang || 'zh';\n      const frag = document.createDocumentFragment();\n      catalog.forEach((ce) => { ce.offerings.forEach((o) => {\n        const card = document.createElement('article');\n        card.className = 'card'; card.style.padding = 'var(--space-xl)';\n        const h4 = document.createElement('h4');\n        h4.style.cssText = 'font-family:var(--font-display);font-size:1.05rem;font-weight:var(--fw-semibold);margin-bottom:var(--space-sm);';\n        h4.textContent = o.name[lang];\n        const stk = document.createElement('p');\n        stk.style.cssText = 'font-size:var(--fs-xs);color:var(--color-slate-400);margin-bottom:var(--space-sm);';\n        stk.textContent = (o.stakeholders[lang] || []).join(' \\\\u00B7 ');\n        const dels = document.createElement('div');\n        dels.style.cssText = 'display:flex;flex-wrap:wrap;gap:var(--space-xs);margin-bottom:var(--space-md);';\n        (o.deliverables[lang] || []).forEach((d) => { const t = document.createElement('span'); t.className = 'card__sub'; t.textContent = d; dels.appendChild(t); });\n        const ttv = document.createElement('p');\n        ttv.style.cssText = 'font-family:var(--font-mono);font-size:var(--fs-xs);color:var(--color-accent);';\n        ttv.textContent = o.timeToValue[lang];\n        card.appendChild(h4); card.appendChild(stk); card.appendChild(dels); card.appendChild(ttv);\n        frag.appendChild(card);\n      }); });\n      grid.innerHTML = ''; grid.appendChild(frag);\n    } catch (e) { console.warn('[Evoing] Service catalog load failed:', e.message); }\n  }\n\n  async function renderCaseStudies() {\n    const grid = document.getElementById('case-studies-grid');\n    const dataEl = document.getElementById('case-studies-data');\n    if (\"'!grid || !dataEl) return;\n    try {\n      const data = await fetchJSON('\"'data/case-studies.json');\n      dataEl.textContent = JSON.stringify(data);\n      const lang = document.documentElement.lang || 'zh';\n      const indLabels = { 'financial-services':{zh:'金融服务',en:'Financial Services'}, 'retail-consumer':{zh:'零售与消费品',en:'Retail & Consumer'}, 'healthcare':{zh:'医疗健康',en:'Healthcare'}, 'manufacturing':{zh:'先进制造',en:'Advanced Manufacturing'}, 'energy':{zh:'能源与碳中和',en:'Energy & Net Zero'}, 'tmt':{zh:'TMT',en:'TMT'}, 'public-sector':{zh:'公共事业',en:'Public Sector'}, 'automotive':{zh:'汽车与出行',en:'Automotive & Mobility'} };\n      const regLabels = { apac:'APAC', emea:'EMEA', amer:'Americas' };\n      const frag = document.createDocumentFragment();\n      data.forEach((cs) => {\n        const card = document.createElement('article');\n        card.className = 'case-study-card';\n        card.dataset.caseId = cs.id;\n        card.dataset.industry = cs.industry;\n        card.dataset.region = cs.region;\n        const metricsHTML = (cs.metrics || []).slice(0,3).map((m) => '<div><div class=\\\"case-study-card__metric-value\\\">' + escHtml(m.value) + '</div><div class=\\\"case-study-card__metric-label\\\">' + escHtml(m.label[lang]) + '</div></div>').join('');\n        card.innerHTML =\n          '<div class=\\\"case-study-card__meta\\\">' +\n          '<span class=\\\"case-study-card__tag case-study-card__tag--industry\\\">' + escHtml((indLabels[cs.industry]||{zh:cs.industry,en:cs.industry})[lang]) + '</span>' +\n          '<span class=\\\"case-study-card__tag case-study-card__tag--region\\\">' + escHtml(regLabels[cs.region]||cs.region) + '</span>' +\n          '</div>' +\n          '<h3 class=\\\"case-study-card__title\\\">' + escHtml(typeof cs.title==='object'?cs.title[lang]:cs.title) + '</h3>' +\n          '<p class=\\\"case-study-card__challenge\\\">' + escHtml(cs.challenge[lang].substring(0,150)) + '...</p>' +\n          '<div class=\\\"case-study-card__metrics\\\">' + metricsHTML + '</div>';\n        frag.appendChild(card);\n      });\n      grid.innerHTML = ''; grid.appendChild(frag);\n    } catch (e) { console.warn('[Evoing] Case studies load failed:', e.message); }\n  }\n\n  async function renderArticles() {\n    const grid = document.getElementById('articles-grid');\n    const dataEl = document.getElementById('articles-data');\n    if (\"'!grid || !dataEl) return;\n    try {\n      const data = await fetchJSON('\"'data/articles.json');\n      dataEl.textContent = JSON.stringify(data);\n      const lang = document.documentElement.lang || 'zh';\n      const catLabels = { 'ai-strategy':{zh:'AI 战略',en:'AI Strategy'}, 'code-modernization':{zh:'代码现代化',en:'Code Modernization'}, 'data-intelligence':{zh:'数据智能',en:'Data Intelligence'}, 'cyber-resilience':{zh:'网络韧性',en:'Cyber Resilience'}, 'operating-model':{zh:'运营模式',en:'Operating Model'}, 'strategy-advisory':{zh:'战略咨询',en:'Strategy Advisory'} };\n      const frag = document.createDocumentFragment();\n      data.forEach((art) => {\n        const card = document.createElement('article');\n        card.className = 'article-card';\n        card.dataset.articleId = art.id;\n        card.dataset.category = art.category;\n        card.dataset.region = art.region;\n        const sectionsHTML = (art.sections[lang] || []).map((s) => '<span class=\\\"article-card__section-tag\\\">' + escHtml(s) + '</span>').join('');\n        card.innerHTML =\n          '<div class=\\\"article-card__meta\\\">' +\n          '<span class=\\\"article-card__category\\\">' + escHtml((catLabels[art.category]||{zh:art.category,en:art.category})[lang]) + '</span>' +\n          '<span class=\\\"article-card__region\\\">' + art.region.toUpperCase() + '</span>' +\n          '<span class=\\\"article-card__reading-time\\\">' + escHtml(art.readingTime[lang]) + '</span>' +\n          '</div>' +\n          '<h3 class=\\\"article-card__headline\\\">' + escHtml(art.headline[lang]) + '</h3>' +\n          '<p class=\\\"article-card__deck\\\">' + escHtml(art.deck[lang]) + '</p>' +\n          '<div class=\\\"article-card__sections\\\">' + sectionsHTML + '</div>' +\n          '<div class=\\\"article-card__footer\\\">' +\n          '<span>' + escHtml(art.authors.map((a) => a[lang]).join(', ')) + '</span>' +\n          '<span>' + escHtml(art.date) + '</span>' +\n          '</div>';\n        frag.appendChild(card)