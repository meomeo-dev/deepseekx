ata-lang=\"zh\">代码</span><span data-lang=\"en\" class=\"lang-hidden\">Code</span></button>\n        <button class=\"filter-chip\" data-filter=\"data-intelligence\"><span data-lang=\"zh\">数据</span><span data-lang=\"en\" class=\"lang-hidden\">Data</span></button>\n        <button class=\"filter-chip\" data-filter=\"cyber-resilience\"><span data-lang=\"zh\">安全</span><span data-lang=\"en\" class=\"lang-hidden\">Security</span></button>\n        <button class=\"filter-chip\" data-filter=\"operating-model\"><span data-lang=\"zh\">运营</span><span data-lang=\"en\" class=\"lang-hidden\">Ops</span></button>\n        <button class=\"filter-chip\" data-filter=\"strategy-advisory\"><span data-lang=\"zh\">战略</span><span data-lang=\"en\" class=\"lang-hidden\">Strategy</span></button>\n      </div>\n      <div class=\"filter-bar filter-bar--article-region\" style=\"margin-bottom:var(--space-2xl);\">\n        <button class=\"filter-chip filter-chip--active\" data-filter=\"all\"><span data-lang=\"zh\">全部地区</span><span data-lang=\"en\" class=\"lang-hidden\">All Regions</span></button>\n        <button class=\"filter-chip\" data-filter=\"global\"><span data-lang=\"zh\">全球</span><span data-lang=\"en\" class=\"lang-hidden\">Global</span></button>\n        <button class=\"filter-chip\" data-filter=\"apac\"><span data-lang=\"zh\">亚太</span><span data-lang=\"en\" class=\"lang-hidden\">APAC</span></button>\n        <button class=\"filter-chip\" data-filter=\"emea\"><span data-lang=\"zh\">EMEA</span><span data-lang=\"en\" class=\"lang-hidden\">EMEA</span></button>\n        <button class=\"filter-chip\" data-filter=\"amer\"><span data-lang=\"zh\">美洲</span><span data-lang=\"en\" class=\"lang-hidden\">Americas</span></button>\n      </div>\n      <div class=\"articles-grid\" id=\"articles-grid\"><!-- JS populated --></div>\n    </div>\n  </section>\n\n  <!-- Article preview modal -->\n  <div class=\"article-preview__backdrop\" id=\"article-preview-backdrop\"></div>\n  <div class=\"article-preview\