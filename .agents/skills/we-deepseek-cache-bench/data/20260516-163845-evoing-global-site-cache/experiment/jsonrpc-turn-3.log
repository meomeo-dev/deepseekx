< {"method":"item/completed","params":{"item":{"type":"commandExecution","id":"call_01_3jABM0xDfCAK8K7Mynlf2030","command":"/bin/bash -lc \"cat > /bench/20260516-163845-evoing-global-site-cache/workspace/src/js/main.js << 'ENDOFFILE'\n/**\n * Evoing main entry — orchestrates modules, fetches data-driven sections.\n */\n(function () {\n  async function boot() {\n    await Promise.all([\n      renderSolutions(),\n      renderServiceCatalog(),\n      renderCaseStudies(),\n      renderArticles(),\n      renderOffices(),\n      renderLeadership(),\n      renderCareers(),\n      embedIndustryDeepData()\n    ]);\n\n    /* Animate stats */\n    const stats = document.querySelectorAll('.stat-item__value');\n    if (stats.length > 0) {\n      const obs = new IntersectionObserver((e) => { e.forEach((en) => { if (en.isIntersecting) { en.target.style.animation = 'fadeIn 0.6s ease-out forwards'; obs.unobserve(en.target); } }); }, { threshold: 0.5 });\n      stats.forEach((el) => { el.style.opacity = '0'; obs.observe(el); });\n    }\n\n    /* Reveal cards */\n    const cards = document.querySelectorAll('.card,.case-study-card,.region-card,.leader-card,.insight-card,.article-card,.office-card,.job-card,.solution-card,.methodology-step,.value-card,.path-card');\n    if (cards.length > 0) {\n      const co = new IntersectionObserver((e) => { e.forEach((en) => { if (en.isIntersecting) { en.target.style.animation = 'fadeInUp 0.5s ease-out forwards'; co.unobserve(en.target); } }); }, { threshold: 0.15, rootMargin: '0px 0px -30px 0px' });\n      cards.forEach((el) => { el.style.opacity = '0'; el.style.transform = 'translateY(20px)'; co.observe(el); });\n    }\n\n    console.log('[Evoing] Global site ready.');\n  }\n\n  async function fetchJSON(path) {\n    const resp = await fetch(path);\n    if (\"'!resp.ok) throw new Error(`Failed to load ${path}: ${resp.status}`);\n    return resp.json();\n  }\n\n  function escHtml(s) { return String(s).replace(/&/g,'\"'&amp;').replace(/</g,'&lt;').re