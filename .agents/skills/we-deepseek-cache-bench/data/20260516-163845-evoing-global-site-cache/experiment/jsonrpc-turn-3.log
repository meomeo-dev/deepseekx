< {"method":"item/started","params":{"item":{"type":"commandExecution","id":"call_01_bD74rOEOHdnhFK5E3gOk3383","command":"/bin/bash -lc 'cd /bench/20260516-163845-evoing-global-site-cache/workspace && cat src/js/main.js'","cwd":"/bench/20260516-163845-evoing-global-site-cache/workspace","processId":"99402","source":"unifiedExecStartup","status":"inProgress","commandActions":[{"type":"read","command":"cat src/js/main.js","name":"main.js","path":"/bench/20260516-163845-evoing-global-site-cache/workspace/src/js/main.js"}],"aggregatedOutput":null,"exitCode":null,"durationMs":null},"threadId":"019e2ff1-213e-7f10-918e-56ff4313a1e6","turnId":"019e301b-8339-7881-80a3-28c37b98135d","startedAtMs":1778923597193}}
< {"method":"item/completed","params":{"item":{"type":"commandExecution","id":"call_01_bD74rOEOHdnhFK5E3gOk3383","command":"/bin/bash -lc 'cd /bench/20260516-163845-evoing-global-site-cache/workspace && cat src/js/main.js'","cwd":"/bench/20260516-163845-evoing-global-site-cache/workspace","processId":"99402","source":"unifiedExecStartup","status":"completed","commandActions":[{"type":"read","command":"cat src/js/main.js","name":"main.js","path":"/bench/20260516-163845-evoing-global-site-cache/workspace/src/js/main.js"}],"aggregatedOutput":"/**\n * Evoing main entry — orchestrates modules, fetches data-driven sections.\n */\n(function () {\n  async function boot() {\n    /* I18n, Navigation, Filter, Insights, Methodology, IndustryDetail, ContactForm\n       already self-init via their own DOMContentLoaded listeners. */\n\n    /* Load data-driven sections */\n    await Promise.all([\n      renderServiceCatalog(),\n      renderInsights(),\n      renderLeadership(),\n      embedIndustryDeepData()\n    ]);\n\n    /* Animate stats counters on scroll */\n    const stats = document.querySelectorAll('.stat-item__value');\n    if (stats.length > 0) {\n      const observer = new IntersectionObserver((entries) => {\n        entries.forEach((entry) => {\n          if (entry.isIntersecting) {\n            entry.target.style.animation = 'fadeIn 0.6s ease-out forwards';\n            observer.unobserve(entry.target);\n          }\n        });\n      }, { threshold: 0.5 });\n      stats.forEach((el) => { el.style.opacity = '0'; observer.observe(el); });\n    }\n\n    /* Reveal cards on scroll */\n    const cards = document.querySelectorAll('.card, .case-card, .region-card, .leader-card, .insight-card, .methodology-step');\n    if (cards.length > 0) {\n      const cardObserver = new IntersectionObserver((entries) => {\n        entries.forEach((entry) => {\n          if (entry.isIntersecting) {\n            entry.target.style.animation = 'fadeInUp 0.5s ease-out forwards';\n            cardObserver.unobserve(entry.target);\n          }\n        });\n      }, { threshold: 0.15, rootMargin: '0px 0px -30px 0px' });\n      cards.forEach((el) => {\n        el.style.opacity = '0';\n        el.style.transform = 'translateY(20px)';\n        cardObserver.observe(el);\n      });\n    }\n\n    console.log('[Evoing] Global site ready.');\n  }\n\n  async function fetchJSON(path) {\n    const resp = await fetch(path);\n    if (!resp.ok) throw new Error(`Failed to load ${path}: ${resp.status}`);\n    return resp.json();\n  }\n\n  async function renderServiceCatalog() {\n    const grid = document.getElementById('service-grid');\n    if (!grid) return;\n    try {\n      const catalog = await fetchJSON('data/service-catalog.json');\n      const lang = document.documentElement.lang || 'zh';\n      const frag = document.createDocumentFragment();\n\n      catalog.forEach((capEntry) => {\n        capEntry.offerings.forEach((offering) => {\n          const card = document.createElement('article');\n          card.className = 'card';\n          card.style.padding = 'var(--space-xl)';\n\n          const title = document.createElement('h4');\n          title.style.cssText = 'font-family:var(--font-display);font-size:1.05rem;font-weight:var(--fw-semibold);margin-bottom:var(--space-sm);';\n          title.textContent = offering.name[lang];\n\n          const stakeholders = document.createElement('p');\n          stakeholders.style.cssText = 'font-size:var(--fs-xs);color:var(--color-slate-400);margin-bottom:var(--space-sm);';\n          stakeholders.textContent = (offering.stakeholders[lang] || []).join(' \\u00B7 ');\n\n          const deliverables = document.createElement('div');\n          deliverables.style.cssText = 'display:flex;flex-wrap:wrap;gap:var(--space-xs);margin-bottom:var(--space-md);';\n          (offering.deliverables[lang] || []).forEach((d) => {\n            const tag = document.createElement('span');\n            tag.className = 'card__sub';\n            tag.textContent = d;\n            deliverables.appendChild(tag);\n          });\n\n          const ttv = document.createElement('p');\n          ttv.style.cssText = 'font-family:var(--font-mono);font-size:var(--fs-xs);color:var(--color-accent);';\n          ttv.innerHTML = '<span data-lang=\"zh\">实现价值时间：</span><span data-lang=\"en\" class=\"lang-hidden\">Time to value: </span>' + offering.timeToValue[lang];\n\n          card.appendChild(title);\n          card.appendChild(stakeholders);\n          card.appendChild(deliverables);\n          card.appendChild(ttv);\n          frag.appendChild(card);\n        });\n      });\n\n      grid.innerHTML = '';\n      grid.appendChild(frag);\n    } catch (e) {\n      console.warn('[Evoing] Service catalog load failed:', e.message);\n      grid.innerHTML = '<p style=\"color:var(--color-text-secondary);grid-column:1/-1;text-align:center;\">Service catalog data is being prepared.</p>';\n    }\n  }\n\n  async function renderInsights() {\n    const grid = document.getElementById('insights-grid');\n    if (!grid) return;\n    try {\n      const insights = await fetchJSON('data/insights.json');\n      const lang = document.documentElement.lang || 'zh';\n      const frag = document.createDocumentFragment();\n\n      insights.forEach((ins) => {\n        const card = document.createElement('article');\n        card.className = 'insight-card';\n        card.dataset.category = ins.category;\n        card.dataset.region = ins.region;\n\n        const meta = document.createElement('div');\n        meta.className = 'insight-card__meta';\n        meta.innerHTML =\n          '<span class=\"insight-card__category\">' + escHtml(getCatLabel(ins.category, lang)) + '</span>' +\n          '<span class=\"insight-card__region\">' + ins.region.toUpperCase() + '</span>' +\n          '<span class=\"insight-card__reading-time\">' + escHtml(ins.readingTime[lang]) + '</span>';\n\n        const title = document.createElement('h3');\n        title.className = 'insight-card__title';\n        title.textContent = ins.title[lang];\n\n        const summary = document.createElement('p');\n        summary.className = 'insight-card__summary';\n        summary.textContent = ins.summary[lang];\n\n        const footer = document.createElement('div');\n        footer.className = 'insight-card__footer';\n        const authors = ins.authors.map((a) => a[lang]).join(', ');\n        footer.innerHTML =\n          '<span class=\"insight-card__authors\">' + escHtml(authors) + '</span>' +\n          '<span class=\"insight-card__date\">' + escHtml(ins.date) + '</span>';\n\n        card.appendChild(meta);\n        card.appendChild(title);\n        card.appendChild(summary);\n        card.appendChild(footer);\n        frag.appendChild(card);\n      });\n\n      grid.innerHTML = '';\n      grid.appendChild(frag);\n    } catch (e) {\n      console.warn('[Evoing] Insights load failed:', e.message);\n      grid.innerHTML = '<p style=\"color:var(--color-slate-400);grid-column:1/-1;text-align:center;\">Insights are being prepared.</p>';\n    }\n  }\n\n  async function renderLeadership() {\n    const grid = document.getElementById('leadership-grid');\n    if (!grid) return;\n    try {\n      const leaders = await fetchJSON('data/leadership.json');\n      const lang = document.documentElement.lang || 'zh';\n      const frag = document.createDocumentFragment();\n\n      leaders.forEach((l) => {\n        const card = document.createElement('div');\n        card.className = 'leader-card';\n\n        const name = document.createElement('p');\n        name.className = 'leader-card__name';\n        name.textContent = l.name[lang];\n\n        const title = document.createElement('p');\n        title.className = 'leader-card__title';\n        title.textContent = l.title[lang];\n\n        const location = document.createElement('p');\n        location.className = 'leader-card__location';\n        location.textContent = l.location.replace(/-/g, ' ').replace(/\\b\\w/g, (c) => c.toUpperCase());\n\n        const bio = document.createElement('p');\n        bio.className = 'leader-card__bio';\n        bio.textContent = l.bio[lang];\n\n        const expertise = document.createElement('div');\n        expertise.className = 'leader-card__expertise';\n        (l.expertise[lang] || []).forEach((exp) => {\n          const tag = document.createElement('span');\n          tag.className = 'leader-card__tag';\n          tag.textContent = exp;\n          expertise.appendChild(tag);\n        });\n\n        const langs = document.createElement('p');\n        langs.className = 'leader-card__languages';\n        langs.textContent = (l.languages || []).join(' / ').toUpperCase();\n\n        card.appendChild(name);\n        card.appendChild(title);\n        card.appendChild(location);\n        card.appendChild(bio);\n        card.appendChild(expertise);\n        card.appendChild(langs);\n        frag.appendChild(card);\n      });\n\n      grid.innerHTML = '';\n      grid.appendChild(frag);\n    } catch (e) {\n      console.warn('[Evoing] Leadership load failed:', e.message);\n      grid.innerHTML = '<p style=\"color:var(--color-text-secondary);grid-column:1/-1;text-align:center;\">Leadership profiles are being prepared.</p>';\n    }\n  }\n\n  async function embedIndustryDeepData() {\n    const el = document.getElementById('industry-deep-data');\n    if (!el) return;\n    try {\n      const data = await fetchJSON('data/industry-deep.json');\n      /* Also attach industry labels from industries.json for the panel title */\n      const inds = await fetchJSON('data/industries.json');\n      const labelMap = {};\n      inds.forEach((i) => { labelMap[i.id] = i.label; });\n      data.forEach((d) => { d.label = labelMap[d.id] || { zh: d.id, en: d.id }; });\n      el.textContent = JSON.stringify(data);\n    } catch (e) {\n      console.warn('[Evoing] Industry deep data load failed:', e.message);\n    }\n  }\n\n  function getCatLabel(cat, lang) {\n    const map = {\n      'ai-strategy': { zh: 'AI 战略', en: 'AI Strategy' },\n      'code-modernization': { zh: '代码现代化', en: 'Code Modernization' },\n      'operating-model': { zh: '运营模式', en: 'Operating Model' },\n      'data-intelligence': { zh: '数据智能', en: 'Data Intelligence' },\n      'cyber-resilience': { zh: '网络韧性', en: 'Cyber Resilience' },\n      'strategy-advisory': { zh: '战略咨询', en: 'Strategy Advisory' }\n    };\n    return (map[cat] || { zh: cat, en: cat })[lang];\n  }\n\n  function escHtml(s) {\n    return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/\"/g, '&quot;');\n  }\n\n  if (document.readyState === 'loading') {\n    document.addEventListener('DOMContentLoaded', boot);\n  } else {\n    boot();\n  }\n})();\n","exitCode":0,"durationMs":0},"threadId":"019e2ff1-213e-7f10-918e-56ff4313a1e6","turnId":"019e301b-8339-7881-80a3-28c37b98135d","completedAtMs":1778923597193}}
