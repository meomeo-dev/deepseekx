rd,.case-study-card,.region-card,.leader-card,.insight-card,.article-card,.office-card,.job-card,.solution-card,.methodology-step,.value-card,.path-card');\n    if (cards.length > 0) {\n      const co = new IntersectionObserver((e) => { e.forEach((en) => { if (en.isIntersecting) { en.target.style.animation = 'fadeInUp 0.5s ease-out forwards'; co.unobserve(en.target); } }); }, { threshold: 0.15, rootMargin: '0px 0px -30px 0px' });\n      cards.forEach((el) => { el.style.opacity = '0'; el.style.transform = 'translateY(20px)'; co.observe(el); });\n    }\n\n    console.log('[Evoing] Global site ready.');\n  }\n\n  async function fetchJSON(path) {\n    const resp = await fetch(path);\n    if (!resp.ok) throw new Error(`Failed to load ${path}: ${resp.status}`);\n    return resp.json();\n  }\n\n  function escHtml(s) { return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/\"/g,'&quot;'); }\n\n  async function renderSolutions() {\n    const grid = document.getElementById('solutions-grid');\n    const dataEl = document.getElementById('solutions-data');\n    if (!grid || !dataEl) return;\n    try {\n      const data = await fetchJSON('data/solutions.json');\n      dataEl.textContent = JSON.stringify(data);\n      const lang = document.documentElement.lang || 'zh';\n      const frag = document.createDocumentFragment();\n      data.forEach((s) => {\n        const card = document.createElement('article');\n        card.className = 'solution-card';\n        card.dataset.solutionId = s.id;\n        card.dataset.caps = (s.relatedCapabilities || []).join(',');\n        card.innerHTML =\n          '<h3 class=\"solution-card__name\">' + escHtml(s.name[lang]) + '</h3>' +\n          '<p class=\"solution-card__problem\">' + escHtml(s.problem[lang]) + '</p>' +\n          '<div class=\"solution-card__modules\">' + (s.modules[lang] || []).map((m) => '<span class=\"solution-card__module\">' + escHtml(m) + '</span>').join('') + '</div>' +\n          '<p clas