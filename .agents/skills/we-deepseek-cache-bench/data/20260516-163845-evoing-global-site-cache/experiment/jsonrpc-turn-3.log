hild(h4); card.appendChild(stk); card.appendChild(dels); card.appendChild(ttv);\n        frag.appendChild(card);\n      }); });\n      grid.innerHTML = ''; grid.appendChild(frag);\n    } catch (e) { console.warn('[Evoing] Service catalog load failed:', e.message); }\n  }\n\n  async function renderCaseStudies() {\n    const grid = document.getElementById('case-studies-grid');\n    const dataEl = document.getElementById('case-studies-data');\n    if (!grid || !dataEl) return;\n    try {\n      const data = await fetchJSON('data/case-studies.json');\n      dataEl.textContent = JSON.stringify(data);\n      const lang = document.documentElement.lang || 'zh';\n      const indLabels = { 'financial-services':{zh:'金融服务',en:'Financial Services'}, 'retail-consumer':{zh:'零售与消费品',en:'Retail & Consumer'}, 'healthcare':{zh:'医疗健康',en:'Healthcare'}, 'manufacturing':{zh:'先进制造',en:'Advanced Manufacturing'}, 'energy':{zh:'能源与碳中和',en:'Energy & Net Zero'}, 'tmt':{zh:'TMT',en:'TMT'}, 'public-sector':{zh:'公共事业',en:'Public Sector'}, 'automotive':{zh:'汽车与出行',en:'Automotive & Mobility'} };\n      const regLabels = { apac:'APAC', emea:'EMEA', amer:'Americas' };\n      const frag = document.createDocumentFragment();\n      data.forEach((cs) => {\n        const card = document.createElement('article');\n        card.className = 'case-study-card';\n        card.dataset.caseId = cs.id;\n        card.dataset.industry = cs.industry;\n        card.dataset.region = cs.region;\n        const metricsHTML = (cs.metrics || []).slice(0,3).map((m) => '<div><div class=\"case-study-card__metric-value\">' + escHtml(m.value) + '</div><div class=\"case-study-card__metric-label\">' + escHtml(m.label[lang]) + '</div></div>').join('');\n        card.innerHTML =\n          '<div class=\"case-study-card__meta\">' +\n          '<span class=\"case-study-card__tag case-study-card__tag--industry\">' + escHtml((indLabels[cs.industry]||{zh:cs.industry,en:cs.industry})[lang]) + '</span>' +\n          '<span class=\"case-stu