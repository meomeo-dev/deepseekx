sert(await fileExists(f), `${f} exists`);\n}\n\n// --- 2. JSON data validity ---\nconsole.log('\\n2. JSON validity & structure');\n\nlet nav, caps, inds, regs, cas, meth, svcCat, indDeep, insights, leaders;\n\ntry {\n  nav = await readJson('src/data/navigation.json');\n  assert(Array.isArray(nav.primary) && nav.primary.length >= 5, 'navigation.primary has >= 5 items');\n} catch (e) { assert(false, `navigation.json: ${e.message}`); }\n\ntry {\n  caps = await readJson('src/data/capabilities.json');\n  assert(Array.isArray(caps) && caps.length >= 6, 'capabilities has >= 6 items');\n  caps.forEach((c, i) => {\n    assert(c.id && c.label.zh && c.summary.zh, `capability[${i}] has bilingual label+summary`);\n    assert(Array.isArray(c.subs) && c.subs.length >= 3, `capability[${i}] has >= 3 subs`);\n  });\n} catch (e) { assert(false, `capabilities.json: ${e.message}`); }\n\ntry {\n  inds = await readJson('src/data/industries.json');\n  assert(Array.isArray(inds) && inds.length >= 8, 'industries has >= 8 items');\n} catch (e) { assert(false, `industries.json: ${e.message}`); }\n\ntry {\n  regs = await readJson('src/data/regions.json');\n  assert(Array.isArray(regs) && regs.length === 3, 'regions has 3 items');\n} catch (e) { assert(false, `regions.json: ${e.message}`); }\n\ntry {\n  cas = await readJson('src/data/cases.json');\n  assert(Array.isArray(cas) && cas.length >= 3, 'cases has >= 3 items');\n} catch (e) { assert(false, `cases.json: ${e.message}`); }\n\ntry {\n  meth = await readJson('src/data/methodology.json');\n  assert(meth.steps && Array.isArray(meth.steps) && meth.steps.length === 6, 'methodology has 6 steps');\n  meth.steps.forEach((s, i) => {\n    assert(s.id && s.label.zh && s.summary.zh, `methodology step[${i}] has bilingual label+summary`);\n    assert(Array.isArray(s.deliverables.zh) && s.deliverables.zh.length >= 3, `step[${i}] has >= 3 deliverables`);\n  });\n  assert(Array.isArray(meth.principles) && meth.principles.length === 3, 'methodology has 3 principles');\n} catch (e) { assert(false, `methodology.json: ${e.message}`); }\n\ntry {\n  svcCat = await readJson('src/data/service-catalog.json');\n  assert(Array.isArray(svcCat) && svcCat.length === 6, 'service-catalog has 6 capability entries');\n  svcCat.forEach((ce, i) => {\n    assert(Array.isArray(ce.offerings) && ce.offerings.length >= 2, `service-catalog[${i}] has >= 2 offerings`);\n    ce.offerings.forEach((o, j) => {\n      assert(o.id && o.name.zh && o.deliverables.zh, `offering[${i}][${j}] has bilingual name+deliverables`);\n      assert(Array.isArray(o.stakeholders.zh) && o.stakeholders.zh.length >= 1, `offering[${i}][${j}] has stakeholders`);\n      assert(o.timeToValue.zh, `offering[${i}][${j}] has timeToValue`);\n    });\n  });\n} catch (e) { assert(false, `service-catalog.json: ${e.message}`); }\n\ntry {\n  indDeep = await readJson('src/data/industry-deep.json');\n  assert(Array.isArray(indDeep) && indDeep.length === 8, 'industry-deep has 8 entries');\n  indDeep.forEach((d, i) => {\n    assert(d.id && d.painPoints.zh && d.approach.zh, `industry-deep[${i}] has painPoints+approach`);\n    assert(Array.isArray(d.outcomes.zh) && d.outcomes.zh.length >= 3, `industry-deep[${i}] has >= 3 outcomes`);\n    assert(Array.isArray(d.relatedCaps) && d.relatedCaps.length >= 1, `industry-deep[${i}] has relatedCaps`);\n  });\n} catch (e) { assert(false, `industry-deep.json: ${e.message}`); }\n\ntry {\n  insights = await readJson('src/data/insights.json');\n  assert(Array.isArray(insights) && insights.length >= 10, 'insights has >= 10 entries');\n  insights.forEach((ins, i) => {\n    assert(ins.id && ins.title.zh && ins.summary.zh, `insight[${i}] has bilingual title+summary`);\n    assert(ins.category && ins.region && ins.readingTime.zh, `insight[${i}] has category+region+readingTime`);\n    assert(Array.isArray(ins.authors) && ins.authors.length >= 1, `insight[${i}] has >= 1 author`);\n  });\n} catch (e) { assert(false, `insights.json: ${e.message}`); }\n\ntry {\n  leaders = await readJson('src/data/leadership.json');\n  assert(Array.isArray(leaders) && leaders.length >= 8, 'leadership has >= 8 entries');\n  leaders.forEach((l, i) => {\n    assert(l.id && l.name.zh && l.title.zh, `leader[${i}] has bilingual name+title`);\n    assert(l.expertise.zh && l.languages && l.bio.zh, `leader[${i}] has expertise+languages+bio`);\n  });\n} catch (e) { assert(false, `leadership.json: ${e.message}`); }\n\n// --- 3. HTML structure ---\nconsole.log('\\n3. HTML structure');\nconst html = await readText('src/index.html');\nassert(html.includes('<!DOCTYPE html>'), 'HTML has DOCTYPE');\nassert(html.includes('<html lang='), 'HTML has lang attribute');\nassert(html.includes('智能及代码'), 'HTML contains tagline (zh)');\nassert(html.includes('Intelligence'), 'HTML contains tagline (en)');\nassert(html.includes('data-lang=\"zh\"'), 'HTML has zh data-lang attributes');\nassert(html.includes('data-lang=\"en\"'), 'HTML has en data-lang attributes');\nassert(html.includes('id=\"lang-toggle\"'), 'HTML has language toggle');\nassert(html.includes('id=\"mobile-toggle\"'), 'HTML has mobile nav toggle');\nassert(html.includes('id=\"hero\"'), 'HTML has hero section');\nassert(html.includes('id=\"capabilities\"'), 'HTML has capabilities section');\nassert(html.includes('id=\"methodology\"'), 'HTML has methodology section');\nassert(html.includes('id=\"services\"'), 'HTML has services section');\nassert(html.includes('id=\"industries\"'), 'HTML has industries section');\nassert(html.includes('id=\"insights\"'), 'HTML has insights section');\nassert(html.includes('id=\"leadership\"'), 'HTML has leadership section');\nassert(html.includes('id=\"careers\"'), 'HTML has careers section');\nassert(html.includes('id=\"contact\"'), 'HTML has contact section');\nassert(html.includes('id=\"regions\"'), 'HTML has regions section');\nassert(html.includes('id=\"contact-form\"'), 'HTML has contact form with id');\nassert(html.includes('id=\"industry-detail-panel\"'), 'HTML has industry detail panel');\nassert(html.includes('id=\"insights-grid\"'), 'HTML has insights grid');\nassert(html.includes('id=\"leadership-grid\"'), 'HTML has leadership grid');\nassert(html.includes('id=\"service-grid\"'), 'HTML has service grid');\nassert(html.includes('id=\"methodology-timeline\"'), 'HTML has methodology timeline');\nassert(html.includes('footer'), 'HTML has footer');\n\n// New nav items\nassert(html.includes('data-target=\"methodology\"'), 'nav has methodology link');\n\n// --- 4. CSS ---\nconsole.log('\\n4. CSS modules');\nconst mainCSS = await readText('src/css/main.css');\nassert(mainCSS.includes('methodology.css'), 'main.css imports methodology.css');\nassert(mainCSS.includes('insights.css'), 'main.css imports insights.css');\nassert(mainCSS.includes('industry-detail.css'), 'main.css imports industry-detail.css');\nassert(mainCSS.includes('leadership.css'), 'main.css imports leadership.css');\nassert(mainCSS.includes('.toast'), 'main.css has toast styles');\nassert(mainCSS.includes('contact-form__input--error'), 'main.css has error state styles');\n\nconst methCSS = await readText('src/css/methodology.css');\nassert(methCSS.includes('methodology-timeline'), 'methodology.css has timeline styles');\nassert(methCSS.includes('methodology-step--active'), 'methodology.css has active step state');\n\nconst insCSS = await readText('src/css/insights.css');\nassert(insCSS.includes('insight-card'), 'insights.css has card styles');\nassert(insCSS.includes('insights-grid'), 'insights.css has grid styles');\n\nconst indDetCSS = await readText('src/css/industry-detail.css');\nassert(indDetCSS.includes('industry-detail--open'), 'industry-detail.css has open state');\nassert(indDetCSS.includes('industry-summary-card'), 'industry-detail.css has summary card styles');\n\n// --- 5. JavaScript ---\nconsole.log('\\n5. JavaScript modules');\nconst insightsJS = await readText('src/js/insights.js');\nassert(insightsJS.includes('filter-bar--insight-cat'), 'insights.js handles category filter');\nassert(insightsJS.includes('filter-bar--insight-region'), 'insights.js handles region filter');\n\nconst contactJS = await readText('src/js/contact.js');\nassert(contactJS.includes('isValidEmail'), 'contact.js validates email');\nassert(contactJS.includes('showToast'), 'contact.js has toast feedback');\nassert(contactJS.includes('contact-form__input--error'), 'contact.js uses error class');\n\nconst methJS = await readText('src/js/methodology.js');\nassert(methJS.includes('IntersectionObserver'), 'methodology.js uses IntersectionObserver');\nassert(methJS.includes('methodology-step--active'), 'methodology.js toggles active state');\n\nconst indDetJS = await readText('src/js/industry-detail.js');\nassert(indDetJS.includes('industry-detail-panel'), 'industry-detail.js references panel');\nassert(indDetJS.includes('populatePanel'), 'industry-detail.js populates panel');\n\nconst mainJS = await readText('src/js/main.js');\nassert(mainJS.includes('renderServiceCatalog'), 'main.js renders service catalog');\nassert(mainJS.includes('renderInsights'), 'main.js renders insights');\nassert(mainJS.includes('renderLeadership'), 'main.js renders leadership');\nassert(mainJS.includes('embedIndustryDeepData'), 'main.js embeds industry deep data');\n\n// --- 6. Business rules ---\nconsole.log('\\n6. Business rules');\nconst capIds = caps.map((c) => c.id);\nconst indIds = inds.map((i) => i.id);\nconst regionIds = regs.map((r) => r.id);\n\n// Service catalog references valid capabilities\nsvcCat.forEach((ce) => {\n  assert(capIds.includes(ce.capabilityId), `service-catalog references valid capability ${ce.capabilityId}`);\n});\n\n// Industry deep references valid industries and capabilities\nindDeep.forEach((d) => {\n  assert(indIds.includes(d.id), `industry-deep references valid industry ${d.id}`);\n  d.relatedCaps.forEach((rc) => {\n    assert(capIds.includes(rc), `industry-deep ${d.id} references valid capability ${rc}`);\n  });\n});\n\n// Cases reference valid industry, region, capability\ncas.forEach((c) => {\n  assert(indIds.includes(c.industry), `case ${c.id} industry valid`);\n  assert(regionIds.includes(c.region), `case ${c.id} region valid`);\n  assert(capIds.includes(c.capability), `case ${c.id} capability valid`);\n});\n\n// Insights reference valid categories and regions\nconst validRegions = ['global', 'apac', 'emea', 'amer'];\ninsights.forEach((ins) => {\n  assert(capIds.includes(ins.category) || ins.category === 'strategy-advisory', `insight ${ins.id} category valid`);\n  assert(validRegions.includes(ins.region), `insight ${ins.id} region valid`);\n});\n\n// Leadership references valid regions\nleaders.forEach((l) => {\n  assert(regionIds.includes(l.region) || l.region === 'global', `leader ${l.id} region valid`);\n});\n\n// Nav items must reference existing HTML sections\nconst navIds = nav.primary.map((n) => n.id);\nfor (const nid of navIds) {\n  assert(html.includes(`id=\"${nid}\"`), `nav item ${nid} has matching HTML section`);\n}\n\n// --- 7. Server ---\nconsole.log('\\n7. Server startup');\nconst serverJS = await readText('server.mjs');\nassert(serverJS.includes('0.0.0.0'), 'server binds to 0.0.0.0');\nassert(serverJS.includes('5173'), 'server uses port 5173');\n\n// --- 8. Package scripts ---\nconsole.log('\\n8. Package scripts');\nconst pkg = await readJson('package.json');\nassert(pkg.scripts && pkg.scripts.start && pkg.scripts.test, 'package.json has start and test scripts');\n\n// --- 9. First-party line count ---\nconsole.log('\\n9. First-party source lines');\nasync function countLines(relPath) {\n  const text = await readText(relPath);\n  return text.split('\\n').length;\n}\n\nconst srcFiles = [\n  'src/index.html',\n  'src/css/brand.css', 'src/css/layout.css', 'src/css/components.css', 'src/css/main.css',\n  'src/css/methodology.css', 'src/css/insights.css', 'src/css/industry-detail.css', 'src/css/leadership.css',\n  'src/js/i18n.js', 'src/js/navigation.js', 'src/js/filter.js', 'src/js/main.js',\n  'src/js/insights.js', 'src/js/contact.js', 'src/js/methodology.js', 'src/js/industry-detail.js',\n  'src/data/navigation.json', 'src/data/capabilities.json', 'src/data/industries.json',\n  'src/data/regions.json', 'src/data/cases.json', 'src/data/methodology.json',\n  'src/data/service-catalog.json', 'src/data/industry-deep.json', 'src/data/insights.json',\n  'src/data/leadership.json',\n  'server.mjs', 'scripts/validate.mjs'\n];\n\nlet totalLines = 0;\nfor (const f of srcFiles) {\n  const lines = await countLines(f);\n  totalLines += lines;\n  console.log(`  ${String(lines).padStart(5)}  ${f}`);\n}\nconsole.log(`  -----  ----------`);\nconsole.log(`  ${String(totalLines).padStart(5)}  TOTAL first-party source lines`);\n\n// --- Summary ---\nconsole.log(`\\n=== Validation Summary ===`);\nconsole.log(`  Checks: ${checks}`);\nconsole.log(`  Passed: ${checks - failures}`);\nconsole.log(`  Failed: ${failures}`);\n\nif (totalLines < 10000) {\n  console.log(`\\n  WARNING: first-party lines (${totalLines}) below 10,000 target.`);\n}\n\nif (failures > 0) {\n  console.log('\\n  Validation FAILED.');\n  process.exit(1);\n} else {\n  console.log('\\n  Validation PASSED.');\n}\nENDOFFILE"}],"aggregatedOutput":null,"exitCode":0,"durationMs":0},"threadId":"019e2ff1-213e-7f10-918e-56ff4313a1e6","turnId":"019e3004-e1ce-7ef2-ba78-b511b980a382","completedAtMs":1778923426306}}
