< {"method":"item/started","params":{"item":{"type":"commandExecution","id":"call_01_NSIcA4VAzCkFQXr1s4hI8310","command":"/bin/bash -lc \"cat > /bench/20260516-163845-evoing-global-site-cache/workspace/src/js/main.js << 'ENDOFFILE'\n(function(){async function boot(){\n  /* Trust, Partners, BrandAssets, Briefings, ValueCalc, DeliveryModel, Journeys\n     all self-init via their own modules. We just need to render data-driven sections. */\n  await Promise.all([renderSolutions(),renderServiceCatalog(),renderCaseStudies(),renderArticles(),renderOffices(),renderLeadership(),renderResources(),renderCareers(),embedIndustryDeepData(),embedBriefingsData(),embedValueModelsData(),renderDeliveryModel()]);\n  const stats=document.querySelectorAll('.stat-item__value');if(stats.length){const o=new IntersectionObserver((e)=>{e.forEach((en)=>{if(en.isIntersecting){en.target.style.animation='fadeIn .6s ease-out forwards';o.unobserve(en.target)}})},{threshold:.5});stats.forEach((el)=>{el.style.opacity='0';o.observe(el)})}\n  const cards=document.querySelectorAll('.card,.case-study-card,.region-card,.leader-card,.insight-card,.article-card,.office-card,.job-card,.solution-card,.methodology-step,.value-card,.path-card,.trust-card,.partner-card,.resource-card,.brand-principle,.pres-module,.download-card,.journey-step-card,.collab-model,.cert-badge,.delivery-center-card,.delivery-gov-card,.delivery-quality-card,.briefing-agenda-item');if(cards.length){const co=new IntersectionObserver((e)=>{e.forEach((en)=>{if(en.isIntersecting){en.target.style.animation='fadeInUp .5s ease-out forwards';co.unobserve(en.target)}})},{threshold:.15,rootMargin:'0px 0px -30px 0px'});cards.forEach((el)=>{el.style.opacity='0';el.style.transform='translateY(20px)';co.observe(el)})}\n  console.log('[Evoing] Ready.')}\nasync function fetchJSON(p){const r=await fetch(p);if(\"'!r.ok)throw new Error(`Failed ${p}`);return r.json()}\nfunction esc(s){return String(s).replace(/&/g,'\"'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/\\\"/g,'&quot;')}\n\nasync function renderSolutions(){const g=document.getElementById('solutions-grid');const de=document.getElementById('solutions-data');if(\"'!g||!de)return;try{const d=await fetchJSON('\"'data/solutions.json');de.textContent=JSON.stringify(d);const l=document.documentElement.lang||'zh';g.innerHTML=d.map(s=>'<article class=\\\"solution-card\\\" data-solution-id=\\\"'+esc(s.id)+'\\\" data-caps=\\\"'+esc((s.relatedCapabilities||[]).join(','))+'\\\"><h3 class=\\\"solution-card__name\\\">'+esc(s.name[l])+'</h3><p class=\\\"solution-card__problem\\\">'+esc(s.problem[l])+'</p><div class=\\\"solution-card__modules\\\">'+(s.modules[l]||[]).map(m=>'<span class=\\\"solution-card__module\\\">'+esc(m)+'</span>').join('')+'</div><p class=\\\"solution-card__outcomes\\\">'+esc(s.outcomes[l])+'</p><div class=\\\"solution-card__metrics\\\">'+(s.metrics[l]||[]).slice(0,2).map(m=>'<span class=\\\"solution-card__metric\\\">'+esc(m)+'</span>').join('')+'</div></article>').join('')}catch(e){console.warn('[Evoing] Sol:',e.message)}}\n\nasync function renderServiceCatalog(){const g=document.getElementById('service-grid');if(\"'!g)return;try{const d=await fetchJSON('\"'data/service-catalog.json');const l=document.documentElement.lang||'zh';g.innerHTML='';d.forEach(ce=>{ce.offerings.forEach(o=>{const c=document.createElement('article');c.className='card';c.style.padding='var(--space-xl)';c.innerHTML='<h4 style=\\\"font-family:var(--font-display);font-size:1.05rem;font-weight:var(--fw-semibold);margin-bottom:var(--space-sm)\\\">'+esc(o.name[l])+'</h4><p style=\\\"font-size:var(--fs-xs);color:var(--color-slate-400);margin-bottom:var(--space-sm)\\\">'+esc((o.stakeholders[l]||[]).join(' \\\\u00B7 '))+'</p><div style=\\\"display:flex;flex-wrap:wrap;gap:var(--space-xs);margin-bottom:var(--space-md)\\\">'+(o.deliverables[l]||[]).map(d=>'<span class=\\\"card__sub\\\">'+esc(d)+'</span>').join('')+'</div><p style=\\\"font-family:var(--font-mono);font-size:var(--fs-xs);color:var(--color-accent)\\\">'+esc(o.timeToValue[l])+'</p>';g.appendChild(c)})})}catch(e){console.warn('[Evoing] Svc:',e.message)}}\n\nasync function renderCaseStudies(){const g=document.getElementById('case-studies-grid');const de=document.getElementById('case-studies-data');if(\"'!g||!de)return;try{const d=await fetchJSON('\"'data/case-studies.json');de.textContent=JSON.stringify(d);const l=document.documentElement.lang||'zh';const il={};['financial-services','retail-consumer','healthcare','manufacturing','energy','tmt','public-sector','automotive'].forEach(k=>{il[k]={zh:['金融服务','零售与消费品','医疗健康','先进制造','能源与碳中和','TMT','公共事业','汽车与出行'][['financial-services','retail-consumer','healthcare','manufacturing','energy','tmt','public-sector','automotive'].indexOf(k)],en:['Financial Services','Retail & Consumer','Healthcare','Advanced Manufacturing','Energy & Net Zero','TMT','Public Sector','Automotive & Mobility'][['financial-services','retail-consumer','healthcare','manufacturing','energy','tmt','public-sector','automotive'].indexOf(k)]}});const rl={apac:'APAC',emea:'EMEA',amer:'Americas'};g.innerHTML=d.map(cs=>{const ti=typeof cs.title==='object'?cs.title[l]:cs.id;const ov=cs.overview?cs.overview[l].substring(0,160)+'...':'';return'<article class=\\\"case-study-card\\\" data-case-id=\\\"'+esc(cs.id)+'\\\" data-industry=\\\"'+esc(cs.industry)+'\\\" data-region=\\\"'+esc(cs.region)+'\\\"><div class=\\\"case-study-card__meta\\\"><span class=\\\"case-study-card__tag case-study-card__tag--industry\\\">'+esc((il[cs.industry]||{zh:cs.industry,en:cs.industry})[l])+'</span><span class=\\\"case-study-card__tag case-study-card__tag--region\\\">'+esc(rl[cs.region]||cs.region)+'</span></div><h3 class=\\\"case-study-card__title\\\">'+esc(ti||cs.id)+'</h3><p class=\\\"case-study-card__challenge\\\">'+esc(ov)+'</p><div class=\\\"case-study-card__metrics\\\">'+(cs.metrics||[]).slice(0,3).map(m=>'<div><div class=\\\"case-study-card__metric-value\\\">'+esc(m.value)+'</div><div class=