<span data-lang=\"zh\">全部</span><span data-lang=\"en\" class=\"lang-hidden\">All</span></button><button class=\"filter-chip\" data-filter=\"ai-strategy\">AI</button><button class=\"filter-chip\" data-filter=\"code-modernization\"><span data-lang=\"zh\">代码</span><span data-lang=\"en\" class=\"lang-hidden\">Code</span></button><button class=\"filter-chip\" data-filter=\"data-intelligence\"><span data-lang=\"zh\">数据</span><span data-lang=\"en\" class=\"lang-hidden\">Data</span></button><button class=\"filter-chip\" data-filter=\"cyber-resilience\"><span data-lang=\"zh\">安全</span><span data-lang=\"en\" class=\"lang-hidden\">Security</span></button><button class=\"filter-chip\" data-filter=\"operating-model\"><span data-lang=\"zh\">运营</span><span data-lang=\"en\" class=\"lang-hidden\">Ops</span></button><button class=\"filter-chip\" data-filter=\"strategy-advisory\"><span data-lang=\"zh\">战略</span><span data-lang=\"en\" class=\"lang-hidden\">Strategy</span></button></div><div class=\"solutions-grid\" id=\"solutions-grid\"></div></div></section>\n<div class=\"solution-drawer__backdrop\" id=\"solution-drawer-backdrop\"></div>\n<div class=\"solution-drawer\" id=\"solution-drawer\"><button class=\"solution-drawer__close\">&times;</button><h2 class=\"solution-drawer__title\"></h2><div class=\"solution-drawer__section\"><p class=\"solution-drawer__section-title\"><span data-lang=\"zh\">挑战</span><span data-lang=\"en\" class=\"lang-hidden\">Challenge</span></p><p class=\"solution-drawer__text solution-drawer__problem\"></p></div><div class=\"solution-drawer__section\"><p class=\"solution-drawer__section-title\"><span data-lang=\"zh\">方法</span><span data-lang=\"en\" class=\"lang-hidden\">Approach</span></p><p class=\"solution-drawer__text solution-drawer__approach\"></p></div><div class=\"solution-drawer__section\"><p class=\"solution-drawer__section-title\"><span data-lang=\"zh\">模块</span><span data-lang=\"en\" class=\"lang-hidden\">Modules</span></p><div class=\"solution-drawer